# ============================================================================
# Variables de entorno para PRODUCCIÓN / STAGING (Vercel)
# ============================================================================
# Estas variables se configuran en Vercel → Settings → Environment Variables.
# NO se ponen en .env del repo (porque .env va en .gitignore).
#
# Cuando Vercel detecte un push a `main`, hará deploy automático usando estas
# variables. Si tienes una rama `staging`, puedes definir distintos valores
# para "Production" vs "Preview" en Vercel.
# ============================================================================


# ─── Base de datos (Neon, region eu-central-1) ─────────────────────────────
# Connection string completa de Neon. Debe incluir ?sslmode=require al final.
# Si Neon te da una "Pooled connection" (recomendada para Vercel), usa esa.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# ─── URL pública (debe coincidir con el dominio servido por Vercel) ────────
# En producción real:
NEXT_PUBLIC_BASE_URL="https://app.fisiofitteam.com"

# En staging (mientras Vercel da dominio temporal tipo xxxx.vercel.app):
# NEXT_PUBLIC_BASE_URL="https://fisio-app.vercel.app"


# ─── Envío de emails (Resend) ───────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="FisioFit App <noreply@fisiofitteam.com>"


# ─── Bypass de login: DEBE estar a "false" en producción ───────────────────
FISIO_DEV_BYPASS="false"
