# ============================================================================
# FisioFit App — Variables de entorno
# ============================================================================
# Copia este archivo a `.env` (sin el ".example") y rellena los valores.
# El .env NO se sube a git (está en .gitignore). El .env.example sí.
#
# Para desarrollo local, basta con DATABASE_URL y FISIO_DEV_BYPASS="true".
# Para producción se necesitan todas las variables marcadas con [PROD].
# ============================================================================


# ─── Base de datos ──────────────────────────────────────────────────────────
# Local (SQLite, archivo en el repo):
DATABASE_URL="file:./dev.db"

# Producción (Postgres en Neon, ejemplo):
# DATABASE_URL="postgresql://usuario:clave@ep-xxxx.eu-central-1.aws.neon.tech/fisiofit?sslmode=require"


# ─── URL pública de la app ──────────────────────────────────────────────────
# Se usa para construir los enlaces que se envían por email (reset password,
# invitación, etc). En local apunta a localhost; en producción al dominio real.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Producción:
# NEXT_PUBLIC_BASE_URL="https://app.fisiofitteam.com"


# ─── Envío de emails (Resend) ───────────────────────────────────────────────
# Sin esta clave los emails NO se envían: se imprimen por consola.
# Útil en local para no spamear ni gastar cuota mientras se trastea.
# [PROD] necesaria en producción para que lleguen los códigos y las invitaciones.
RESEND_API_KEY=""

# Remitente (debe estar verificado en Resend → tu dominio).
# Si no se pone, usa "FisioFit App <noreply@fisiofitteam.com>" por defecto.
EMAIL_FROM="FisioFit App <noreply@fisiofitteam.com>"


# ─── Desarrollo local: bypass de login ──────────────────────────────────────
# Si está en "true", la app ignora el flow real de login en local y permite
# usar el "switch user" antiguo (cookies active-pro-id / active-patient-id).
# Mantén esto a "true" en desarrollo para no tener que loguearte cada vez.
# [PROD] DEBE estar a "false" o sin definir en producción.
FISIO_DEV_BYPASS="true"


# ─── Bootstrap del primer CEO (solo primera vez en cada entorno nuevo) ──────
# Usado por `npm run bootstrap:admin` para crear el primer profesional con
# rol "ceo" cuando la BD está vacía. Después del primer arranque ya no se usa.
# Solo se procesa si NO hay ningún profesional creado todavía.
ADMIN_EMAIL=""
ADMIN_NAME=""
