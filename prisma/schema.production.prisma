generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id              String   @id @default(cuid())
  fullName        String
  email           String?  @unique                  // para login con código de 6 dígitos
  phone           String?                           // teléfono de contacto (editable desde la ficha)
  instagram       String?                           // @usuario IG (editable desde la ficha)
  photoUrl        String?                           // foto de perfil del paciente
  sport           String   @default("CrossFit")
  diagnosis       String?
  bodyZone        String?                             // zona corporal clínica (hombro, lumbar...)
  startedAt       DateTime @default(now())

  subscriptionStartDate    DateTime?
  subscriptionPeriodMonths Int       @default(4)
  subscriptionTotalMonths  Int       @default(4)

  whatsappGroupUrl         String?

  // Aviso diario a las 7:00 Madrid con las tareas del día.
  // Por defecto activo. El paciente puede silenciarlo desde sus ajustes.
  dailyReminderEnabled     Boolean  @default(true)

  // Parche de bienvenida (regalo del setter al iniciar el programa)
  patchSent                Boolean   @default(false)
  patchSentAt              DateTime?
  // Camiseta ADVANCE: se le pregunta la talla al paciente al entrar en ADVANCE.
  // El equipo (setter / manager) la prepara y envía. shirtSize: "XS"|"S"|"M"|"L"|"XL"|"XXL".
  shirtSize                String?
  // Si true, el paciente NO ve el selector de talla de camiseta y queda fuera
  // de las listas de envíos pendientes (camisetas Y parches). Se usa para
  // pacientes migrados manualmente que ya recibieron sus regalos fuera de la
  // plataforma. Se marca automáticamente al crear con `legacy: true`.
  giftsAlreadySent         Boolean    @default(false)
  shirtSent                Boolean   @default(false)
  shirtSentAt              DateTime?
  shippingAddress          String?    // legacy / texto libre (se mantiene por compat)
  shippingStreet           String?    // calle (ej. "Calle Mayor")
  shippingNumber           String?    // número (ej. "23")
  shippingFloor            String?    // piso (ej. "3º")
  shippingStaircase        String?    // escalera / patio
  shippingDoor             String?    // puerta (ej. "A")
  shippingCity             String?    // población
  shippingProvince         String?    // provincia
  shippingPostalCode       String?    // código postal
  shippingPhone            String?
  // País del paciente. Se copia desde Lead.country al convertir. Se usa
  // para filtrar envíos físicos (parches/camisetas) a solo España por
  // logística. Null = legacy, se asume España.
  country                  String?
  // Zona horaria IANA del paciente (ej. "America/Bogota", "Europe/Madrid").
  timezone                 String?

  // Config de alertas por metricas del daily-log (override por paciente).
  // JSON stringificado: { [metricKey]: { enabled, direction, thresholdPct, windowDays } }.
  // Null = usar la plantilla global (MetricAlertTemplate.global).
  metricAlertConfig        String?

  // "Modo fantasma": pacientes de prueba creados por el CEO. NO cuentan
  // en KPIs, ventas, alertas, resumenes semanales ni crons. Visibles en
  // el listado con badge. Solo CEO puede marcar/desmarcar.
  isTest                   Boolean  @default(false)

  // Tipo de programa contratado y dificultad percibida (etiquetas visibles)
  programType String?                                   // "RECUPERA" | "CONSOLIDA" | "ADVANCE"
  difficulty  String?                                   // "FACIL" | "MEDIO" | "DIFICIL"

  // Modo de programa:
  //   "fixed"   = programa individual de N semanas (RECUPERA, CONSOLIDA, etc) - el original
  //   "rolling" = programa "a tiempo corrido" compartido (ADVANCE) - ve la semana actual del calendario
  programMode      String   @default("fixed")

  // Slot LEGACY (mantenido por compat con datos antiguos). En v49+ se usa
  // como "Rolling de entrenamiento" si rollingTrainingId es null.
  rollingProgramId String?
  rollingProgram   RollingProgram? @relation("PatientLegacyRolling", fields: [rollingProgramId], references: [id])

  // ADVANCE multi-Rolling: dos slots fijos con nombre semántico estable.
  // Accesorios: contenido de calentamiento/movilidad compartido con PREVENTION.
  // Entrenamiento: contenido específico de ADVANCE.
  rollingAccessoriesId String?
  rollingAccessories   RollingProgram? @relation("PatientAccessoriesRolling", fields: [rollingAccessoriesId], references: [id])
  rollingTrainingId    String?
  rollingTraining      RollingProgram? @relation("PatientTrainingRolling", fields: [rollingTrainingId], references: [id])

  // Perfil clínico aplicado (opcional)
  appliedLevelId  String?
  appliedLevel    ClinicalLevel? @relation(fields: [appliedLevelId], references: [id])

  // Fisio asignado (null = sin asignar todavía)
  assignedProfessionalId String?
  assignedProfessional   Professional? @relation("PatientAssignedTo", fields: [assignedProfessionalId], references: [id])

  // Revisión de cargas: cada cuántas semanas el fisio quiere revisar el control
  // de cargas del paciente. Se ajusta desde la cabecera del paciente.
  // loadReviewLastAt = última vez que se marcó como revisado; si null se usa
  // startedAt como referencia para la primera revisión.
  loadReviewIntervalWeeks Int      @default(4)
  loadReviewLastAt        DateTime?

  // Notas internas del fisio sobre el paciente. Texto libre, editable desde
  // el botón "Notas" en la cabecera de la ficha. Solo visible al equipo.
  fisioNotes              String?

  // Notas de la "Llamada Anamnesis" (videollamada de valoración inicial con el
  // fisio). Texto libre, editable desde la pestaña Formularios del paciente.
  anamnesisCallNotes      String?

  // Magic link de acceso 1-clic. Niki lo copia desde la ficha del paciente y
  // lo manda por WhatsApp; el paciente lo pulsa y entra a la app sin código
  // ni contraseña. Token con caducidad larga (365 días). Reutilizable mientras
  // siga vigente; regenerable si hay sospecha de fuga.
  accessToken             String?   @unique
  accessTokenExpiresAt    DateTime?

  // ─── ONBOARDING v57 ─────────────────────────────────────────────────────
  // Estado del flujo de onboarding tras pagar:
  //   "pending_assignment" → ha pagado, Miguel aún no le ha asignado fisio
  //   "active"             → fisio asignado, programa en marcha
  //   "paused"             → pausa (vacaciones, lesión secundaria...)
  //   "finished"           → programa terminado
  onboardingStatus       String   @default("active")

  // Fecha en la que el fisio marcó "Semana 0 completada" desde la lista
  // de pacientes. Los pacientes NO legacy con este campo NULL y con
  // subscriptionStartDate < 14 días aparecen en el recuadro amarillo
  // "Onboarding / Semana 0" arriba del todo. Al marcar la casilla,
  // sale de ese recuadro.
  week0CompletedAt       DateTime?

  // Quién y cuándo asignó al fisio (típicamente Miguel = head_success)
  assignedByUserId       String?
  assignedByUser         Professional? @relation("PatientAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt             DateTime?
  assignmentNotes        String?

  // Duración contratada del programa (campos derivados de la compra)
  programDurationMonths  Int?
  programStartDate       DateTime?
  programEndDate         DateTime?

  // Datos para el contrato (firma electrónica)
  contractDNI            String?
  contractSignedAt       DateTime?
  contractSignedFromIP   String?
  contractSignedUserAgent String?
  contractVersion        String?     // "v1", "v2"... para versionar el contrato
  contractTextSnapshot   String?     // texto exacto firmado (legal evidence)

  // Anamnesis (cuestionario inicial del onboarding) — respuestas en JSON
  anamnesisData          String?     // JSON: { [clavePregunta]: valor }
  anamnesisCompletedAt   DateTime?

  // Última vez que abrió la comunidad (para badge "X notificaciones")
  communityLastSeenAt    DateTime?

  // Checklist de tareas iniciales (JSON)
  // Estructura: { "anamnesis": false, "contract": false, "firstSession": false }
  onboardingTasks        Json?

  // Hash de la contraseña (opcional - los pacientes antiguos siguen con login por código).
  // Los pacientes creados desde el flujo de pago v57+ tienen contraseña.
  passwordHash           String?

  adaptations     PatientAdaptation[]
  wodLogs         WodLog[]
  programAssignments ProgramAssignment[]
  metrics         PatientMetric[]
  fisioTasks      FisioTask[]
  scheduledCalls  ScheduledCall[]
  renewals        SubscriptionRenewal[]
  renewalCheckouts RenewalCheckout[]
  subscriptions   PatientSubscription[]
  clinicalSessionCase ClinicalSessionCase?
  transactions    Transaction[]
  prs             PatientPR[]
  challengeResults MonthlyChallengeResult[]
  dailyLogs       PatientDailyLog[]
  alerts          PatientAlert[]
  weeklyReports   PatientWeeklyReport[]
  advanceSessionLogs AdvanceSessionLog[]
  leadsConverted  Lead[]
  sessions        Session[]
  programPauses   ProgramPause[]
  notifications   PatientNotification[]
  pushTokens      PatientPushToken[]
  loadReviewRecords LoadReviewRecord[]
  categoryLevels  PatientCategoryLevel[]  @relation("PatientCategoryLevels")
  rollingOverrides PatientRollingTaskOverride[] @relation("PatientRollingOverrides")
  sales           Sale[]
  invoices        PatientInvoice[]
  communityComments  CommunityComment[]
  communityReactions CommunityReaction[]
  communityFeedPosts CommunityFeedPost[] @relation("FeedPostPatientAuthor")
  communityLessonProgress CommunityLessonProgress[]
  bannerDismissals   PatientBannerDismiss[]
}

// ============================================================================
// EQUIPO INTERNO (profesionales con rol)
// ============================================================================

model Professional {
  id        String   @id @default(cuid())
  fullName  String
  email     String?  @unique
  role      String                                     // "ceo" | "head_success" | "fisio" | "setter" | "closer"
  createdAt DateTime @default(now())

  // Auth: hash de contraseña bcrypt; null si aún no la ha establecido (recién invitado)
  passwordHash         String?
  // Token de invitación / reseteo de contraseña (one-time)
  passwordResetToken   String?  @unique
  passwordResetExpires DateTime?
  passwordSetAt        DateTime?
  lastLoginAt          DateTime?
  // Si está marcado como inactivo, no puede iniciar sesión (pero conservamos su historial)
  active               Boolean  @default(true)

  // Perfil / datos fiscales (autogestionados desde Ajustes → Perfil; usados en las facturas)
  fiscalName     String?   // nombre o razón social fiscal
  taxId          String?   // NIF / DNI / CIF
  fiscalAddress  String?   // dirección fiscal
  iban           String?
  photoUrl       String?
  workSchedule   String?   // horario de trabajo (texto libre, visible al equipo)
  vatExempt      Boolean   @default(true)  // exento de IVA (art. 20 Ley 37/1992)

  // Presentación corta que el closer usa al iniciar mensajes a leads/pacientes.
  // Se sustituye en plantillas con la variable {closer.intro}. Editable por CEO/head-success en /fisio/equipo.
  closerIntro    String?

  // Preferencias de notificación: JSON { [tipo]: boolean }. Tipo ausente = activado.
  notificationPrefs Json?

  // Última vez que abrió la pestaña Comunidad (para el badge de novedades en el sidebar).
  communityLastSeenAt DateTime?

  patients          Patient[]            @relation("PatientAssignedTo")
  patientsAssignedBy Patient[]           @relation("PatientAssignedBy")
  assignedTasks     FisioTask[]  @relation("AssignedToFisio")
  authoredTasks     FisioTask[]  @relation("AssignedByFisio")
  transactions      Transaction[]
  leadsAsSetter     Lead[]       @relation("LeadsAsSetter")
  leadsAsCloser     Lead[]       @relation("LeadsAsCloser")
  sessions          Session[]
  leaves            ProfessionalLeave[]
  closingShifts     ClosingShift[]       @relation("ClosingShifts")
  defaultShifts     DefaultClosingShift[]
  salesAsCloser     Sale[]               @relation("SaleByCloser")
  salesRefunded     Sale[]               @relation("SaleRefundedBy")
  bannersCreated    PatientBanner[]      @relation("BannerCreatedBy")
  compensation      Compensation?
  communityFeedPosts     CommunityFeedPost[] @relation("FeedPostAuthor")
  communityFeedComments  CommunityComment[]  @relation("FeedCommentAuthor")
  communityFeedReactions CommunityReaction[] @relation("FeedReactionAuthor")
  weeklyTeamTaskCompletions WeeklyTeamTaskCompletion[] @relation("WeeklyTeamTaskCompletions")
  teamTaskAdHocCompletions  TeamTaskAdHocCompletion[]  @relation("TeamTaskAdHocCompletions")
  chatMemberships           ChatMember[]
  loadReviewRecords         LoadReviewRecord[]
  chatMessages              ChatMessage[]              @relation("ChatMessageAuthor")
  alertsSeen                PatientAlert[]             @relation("AlertSeenBy")
  alertsDismissed           PatientAlert[]             @relation("AlertDismissedBy")
}

// Condiciones laborales / compensación de un profesional (1:1). Solo CEO edita.
model Compensation {
  id                   String   @id @default(cuid())
  professionalId       String   @unique
  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  baseSalary           Float    @default(0)   // sueldo fijo €/mes
  perActivePatient     Float    @default(0)   // € por paciente activo
  renewalOwnPct        Float    @default(0)   // % sobre renovaciones de SUS pacientes
  renewalOthersPct     Float    @default(0)   // % sobre renovaciones del resto del equipo
  newSaleCommissionPct Float    @default(0)   // % sobre importe de ventas nuevas
  newSaleScope         String   @default("own") // "own" (cerradas por él) | "all"
  notes                String?
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// Nómina pagada de un profesional en un mes concreto. Al marcarla pagada se crea
// también una Transaction de tipo gasto (sueldos). Único por (profesional, año, mes).
model PayrollPayment {
  id             String   @id @default(cuid())
  professionalId String
  year           Int
  month          Int                              // 0-11
  amount         Float
  transactionId  String?                          // gasto asociado (para poder deshacer)
  paidById       String?
  paidAt         DateTime @default(now())

  @@unique([professionalId, year, month])
  @@index([year, month])
}

// ============================================================================
// FINANZAS (transacciones manuales + renovaciones cuentan automáticamente)
// ============================================================================

model Transaction {
  id          String   @id @default(cuid())
  // type: "income_new" (nueva alta) | "income_renewal" (renovación)
  //       | "income_other" (afiliados/formaciones/etc) | "expense"
  type        String
  // Solo para expense: "software" | "sueldos" | "marketing" | "otros"
  // Para ingresos puede ser null o el nombre del producto
  category    String?
  amount      Float                                      // € (positivo siempre; el signo viene del type)
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  patientId      String?
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type])
}

// ============================================================================
// LEADS / PIPELINE COMERCIAL
// ============================================================================

model Lead {
  id              String    @id @default(cuid())
  fullName        String
  contactType     String                                     // "phone" | "instagram" | "email"
  contactValue    String                                     // ej. "+34 600 123 456" o "@usuario"
  aiSummary       String?                                    // resumen breve de la conversación de la IA setter
  callScheduledAt DateTime                                   // fecha/hora de la llamada
  // status: "scheduled" (agendada) | "won" (venta) | "lost" (perdida)
  //       | "cancelled" (cancela antes) | "no_show" (no acude)
  status          String    @default("scheduled")
  inFollowUp      Boolean   @default(false)                  // vista aparte de follow-up
  followUpNote    String?
  followUpDate    DateTime?                                   // se mantiene por compat (puede usarse como fecha custom)

  // Sistema de follow-up automático: 4 fechas predefinidas con checkbox cada una
  followUpStartedAt DateTime?                                 // momento en que el closer marcó "follow-up"
  followUp24hDate    DateTime?
  followUp24hDone    Boolean @default(false)
  followUp48hDate    DateTime?
  followUp48hDone    Boolean @default(false)
  followUp30dDate    DateTime?
  followUp30dDone    Boolean @default(false)
  followUp90dDate    DateTime?
  followUp90dDone    Boolean @default(false)

  // Setter que registró el lead (solo informativo, hay uno solo por ahora)
  setterId        String?
  setter          Professional? @relation("LeadsAsSetter", fields: [setterId], references: [id], onDelete: SetNull)

  // Closer asignado
  closerId        String?
  closer          Professional? @relation("LeadsAsCloser", fields: [closerId], references: [id], onDelete: SetNull)

  // Si se gana, se convierte en Patient
  convertedPatientId String?
  convertedPatient   Patient? @relation(fields: [convertedPatientId], references: [id], onDelete: SetNull)

  // Si se pierde, razón
  lostReason      String?                                    // "precio" | "no_encaja" | "ghosting" | "otro"

  // ─── Auto-agenda desde landing pública (v54) ───
  // Si el lead vino de la landing pública, se rellenan estos campos.
  // Si lo creó la setter manualmente, quedan null.
  email           String?                                    // correo del formulario público
  phone           String?                                    // teléfono del formulario público
  instagram       String?                                    // @usuario de Instagram (formulario público)
  aiScheduled     Boolean   @default(false)                  // marcar si fue agendado por la IA (para métricas)
  country         String?                                    // país (opcional, no obligatorio)
  motivo          String?                                    // "¿Qué te trae aquí?"
  tratamientosPrevios String?                                // qué ha probado antes
  impactoCrossfit String?                                    // cómo afecta a su entrenamiento
  meetingUrl      String?                                    // URL de Google Meet
  googleEventId   String?                                    // id del evento en Calendar (para sincronizar)
  source          String?                                    // "landing" | "manual" | (futuros: "ads_meta", "ads_google", ...)
  bookedAt        DateTime?                                  // momento exacto en que se hizo la reserva pública

  // ─── Re-agenda autoservicio ───
  // El equipo comercial puede generar un enlace público para que el lead se
  // cambie de hueco sin pasar por ellos. Se genera bajo demanda y se reutiliza
  // (no rota), solo se anula al borrar el lead.
  rescheduleToken     String?   @unique
  rescheduleTokenAt   DateTime?                              // momento en que se generó el token (auditor.)
  rescheduledAt       DateTime?                              // última vez que el lead se reagendó por enlace

  // ─── Etapas comerciales (workflow setter → closer) ───
  // Cuándo el setter marcó "avisado" (paso 1 hecho)
  setterNotifiedAt    DateTime?
  // Cuándo el closer marcó "contactado" (caso de éxito enviado, paso 2 hecho)
  closerContactedAt   DateTime?
  // Cuándo el closer marcó "recordatorio enviado" (paso 3 hecho, día antes de la cita)
  reminderSentAt      DateTime?

  // ─── Atribución de marketing (UTMs capturados en la landing pública) ───
  // Cuando un lead llega vía un anuncio, la landing parsea utm_* del query
  // string y los guarda aquí. Permite cruzar Lead → AdCampaign/Ad para ROAS.
  adUtmCampaign   String?                                     // ej. "hombro_q3_2026"
  adUtmSource     String?                                     // ej. "meta" | "google" | "tiktok"
  adUtmMedium     String?                                     // ej. "paid_social"
  adUtmContent    String?                                     // ej. ad ID o nombre interno del anuncio

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  decidedAt       DateTime?                                   // cuándo se marcó won/lost/postponed

  sales           Sale[]
  fisioTasks      FisioTask[] @relation("LeadFisioTasks")

  sourceTagId     String?
  sourceTag       LeadSourceTag? @relation(fields: [sourceTagId], references: [id], onDelete: SetNull)

  // Resumen IA de la videollamada (Meet transcript → Claude Sonnet).
  callSummary     CallSummary?

  @@index([status])
  @@index([callScheduledAt])
  @@index([closerId])
  @@index([inFollowUp])
  @@index([adUtmCampaign])
  @@index([sourceTagId])
}

model LeadSourceTag {
  id        String   @id @default(cuid())
  label     String   @unique
  color     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]

  @@index([active])
}

model ClinicalProfile {
  id          String          @id @default(cuid())
  name        String                              // "Hombro: Impingement subacromial"
  bodyZone    String                              // "hombro", "lumbar", "rodilla"
  description String?
  createdAt   DateTime        @default(now())

  levels      ClinicalLevel[]
}

model ClinicalLevel {
  id          String          @id @default(cuid())
  profileId   String
  profile     ClinicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String                              // "Nivel 1 - Fase aguda"
  order       Int                                 // 1, 2, 3, 4, 5
  description String?

  rules       ClinicalLevelRule[]
  patients    Patient[]

  @@unique([profileId, order])
}

model ClinicalLevelRule {
  id              String        @id @default(cuid())
  levelId         String
  level           ClinicalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  movementId      String
  movement        Movement      @relation(fields: [movementId], references: [id])

  state           String        // "OK", "CONDITIONAL", "BLOCKED"
  substitutionText String?
  loadConstraint  String?
  physioWarning   String?

  @@unique([levelId, movementId])
}

model MovementCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?

  // Orden en el que se muestra el bloque en /fisio/biblioteca/catalogo
  // y en los controles de cargas. Lo edita el CEO con ↑/↓; al crear un
  // bloque nuevo, va al final automáticamente. 0 por defecto para
  // bloques antiguos: se ordenan luego por name asc como fallback.
  order       Int        @default(0)

  movements   Movement[]
  levels      CategoryLevel[]
  patientSelections PatientCategoryLevel[]
}

// Nivel dentro de una categoría (ej. "Squat → Nivel 1 - Fase aguda").
// El fisio define los niveles que tenga cada categoría (libre, no fijo).
// Por cada nivel, define qué reglas tiene sobre los movimientos de esa
// categoría (state + carga + sustitución + warning).
model CategoryLevel {
  id              String   @id @default(cuid())
  categoryId      String
  category        MovementCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name            String                       // "Nivel 1", "Avanzado"
  order           Int                          // 0, 1, 2…
  description     String?
  createdAt       DateTime @default(now())

  rules           CategoryLevelRule[]
  patientSelections PatientCategoryLevel[]

  @@unique([categoryId, order])
}

// Regla concreta de un nivel sobre un movimiento de su categoría.
model CategoryLevelRule {
  id              String   @id @default(cuid())
  categoryLevelId String
  categoryLevel   CategoryLevel @relation(fields: [categoryLevelId], references: [id], onDelete: Cascade)
  movementId      String
  movement        Movement @relation("MovementRules", fields: [movementId], references: [id], onDelete: Cascade)

  state            String  // "OK" | "CONDITIONAL" | "BLOCKED"
  loadConstraint   String?
  substitutionText String?
  physioWarning    String?

  @@unique([categoryLevelId, movementId])
}

// Asignación actual: por cada categoría, qué nivel tiene el paciente.
// Al cambiar de nivel, se MATERIALIZAN las reglas en PatientAdaptation para
// que el WodAdapter y el resto del código siga consultando la fuente única.
model PatientCategoryLevel {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation("PatientCategoryLevels", fields: [patientId], references: [id], onDelete: Cascade)
  categoryId      String
  category        MovementCategory @relation(fields: [categoryId], references: [id])
  categoryLevelId String
  categoryLevel   CategoryLevel @relation(fields: [categoryLevelId], references: [id])
  updatedAt       DateTime @updatedAt

  @@unique([patientId, categoryId])
  @@index([patientId])
}

model Movement {
  id            String           @id @default(cuid())
  categoryId    String
  category      MovementCategory @relation(fields: [categoryId], references: [id])

  canonicalName String           @unique
  displayName   String
  aliases       String           // CSV: "thr,thrusters,th"

  isOverhead    Boolean          @default(false)
  isImpact      Boolean          @default(false)
  isKipping     Boolean          @default(false)

  adaptations   PatientAdaptation[]
  clinicalRules ClinicalLevelRule[]
  categoryRules CategoryLevelRule[] @relation("MovementRules")
}

model PatientAdaptation {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  movementId       String
  movement         Movement @relation(fields: [movementId], references: [id])

  state            String   // "OK", "CONDITIONAL", "BLOCKED"
  substitutionText String?
  loadConstraint   String?
  physioWarning    String?

  // true si el fisio ha editado esta adaptación a mano desde el editor. Cuando
  // es true, materializePatientCategoryLevels() NO la pisa aunque cambie el
  // nivel del paciente. Volver a "por defecto del nivel" requiere el botón
  // explícito "Restablecer al nivel".
  isCustomized     Boolean  @default(false)

  updatedAt        DateTime @updatedAt

  @@unique([patientId, movementId])
}

model WodLog {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  rawText         String
  adaptedText     String
  rpe             Int?
  painScore       Int?
  notes           String?
  completedAt     DateTime?
  submittedAt     DateTime @default(now())
}

// ============================================================================
// BIBLIOTECA DE EJERCICIOS (con vídeos del fisio)
// ============================================================================

model ExerciseLibrary {
  id          String   @id @default(cuid())
  name        String                                // "Cat-camel", "Strict press"
  bodyZone    String   @default("otros")            // "hombro" | "lumbar" | "rodilla" | "otros"
  category    String                                // "Movilidad", "Activación", "Fuerza"...
  tags        String   @default("")                 // CSV: "hombro,escapular,activación"
  youtubeUrl  String?                                // URL completa o ID
  description String?                                // cues técnicos
  createdAt   DateTime @default(now())

  workoutLinks WorkoutExercise[]
  rollingLinks RollingTaskExercise[]
}

// ============================================================================
// PROGRAMAS (estructura: semanas × 7 días × N tareas)
// ============================================================================

model Program {
  id          String   @id @default(cuid())
  name        String
  bodyZone    String   @default("otros")                // "hombro" | "lumbar" | "rodilla" | "otros"
  type        String                                    // sub-etiqueta: "Movilidad", "Tendinoso", "Exposición"...
  level       Int      @default(1)
  description String?
  weeksCount  Int      @default(4)
  isStandalone Boolean @default(false)                  // true = sesión suelta, no aparece en biblioteca
  createdAt   DateTime @default(now())

  weeks       ProgramWeek[]
  assignments ProgramAssignment[]
}

model ProgramWeek {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  weekNumber  Int                                   // 1, 2, 3, 4...
  notes       String?

  days        ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id          String      @id @default(cuid())
  weekId      String
  week        ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek   Int                                   // 1=lunes, 7=domingo

  tasks       ProgramTask[]

  @@unique([weekId, dayOfWeek])
}

// Una tarea genérica. type indica qué subtabla mirar.
model ProgramTask {
  id        String     @id @default(cuid())
  dayId     String
  day       ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  type      String                                  // "WORKOUT", "VIDEO", "FORM", "EVOLUTION"
  order     Int        @default(0)
  title     String                                  // título visible al paciente

  // Una tarea tiene una y solo una de estas:
  workout      TaskWorkout?
  video        TaskVideo?
  form         TaskForm?
  evolution    TaskEvolution?

  @@index([dayId, order])
}

model TaskWorkout {
  id        String      @id @default(cuid())
  taskId    String      @unique
  task      ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  bodyText  String                                  // bloque de texto libre con el WOD

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id          String          @id @default(cuid())
  workoutId   String
  workout     TaskWorkout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId  String
  exercise    ExerciseLibrary @relation(fields: [exerciseId], references: [id])

  order       Int             @default(0)

  @@unique([workoutId, exerciseId])
}

model TaskVideo {
  id          String      @id @default(cuid())
  taskId      String      @unique
  task        ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  youtubeUrl  String
  description String?
}

model TaskForm {
  id        String      @id @default(cuid())
  taskId    String      @unique
  task      ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  questions String                                  // JSON: [{id, text, type, options?}]
}

model TaskEvolution {
  id          String      @id @default(cuid())
  taskId      String      @unique
  task        ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  instructions String?                              // texto opcional al paciente
}

// ============================================================================
// MÉTRICAS DE EVOLUCIÓN POR PACIENTE
// ============================================================================

model PatientMetric {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  key         String                                 // "pain", "rpe", "stiffness", "strength" o custom
  name        String                                 // "Dolor", "RPE percibido"...
  unit        String?                                // "0-10", "kg", "cm"...
  isPreset    Boolean  @default(false)               // true para las 4 precargadas
  isVisible   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  entries     MetricEntry[]

  @@unique([patientId, key])
  @@index([patientId])
}

model MetricEntry {
  id         String        @id @default(cuid())
  metricId   String
  metric     PatientMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  value      Float
  recordedAt DateTime      @default(now())
  source     String        @default("manual")        // "manual" | "session" | "form"
  sessionId  String?                                  // si vino de completar una sesión

  @@index([metricId, recordedAt])
}

// Métricas GENERALES definidas por el CEO (Biblioteca → Métricas). Se aplican
// a todos los pacientes: al ver su evolución se materializan como PatientMetric
// (así aparecen asignadas aunque no haya datos). key estable.
model MetricDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  unit      String?
  auto      Boolean  @default(false)   // true: se rellena desde las sesiones (pain/rpe/stiffness)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

// ============================================================================
// ASIGNACIONES Y SESIONES
// ============================================================================

model ProgramAssignment {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  programId   String
  program     Program  @relation(fields: [programId], references: [id])

  startDate   DateTime                              // un lunes
  weeksCount  Int                                   // duración real
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  sessions    ProgramSession[]

  @@index([patientId])
}

model ProgramSession {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  weekNumber    Int
  dayOfWeek     Int                                 // 1-7

  // Snapshot de las tareas del día (JSON estructurado)
  tasksSnapshot String                              // JSON: [{id, type, title, ...payload}]

  // Estado completado por el paciente: JSON con respuestas por tarea
  completedAt   DateTime?
  responses     String?                              // JSON: {taskId: {...respuestas}}
  patientNotes  String?                              // Sensaciones del paciente tras completar

  // Revisión por el fisio (solo aplica si la sesión tenía formularios completados)
  formReviewedAt DateTime?

  @@index([scheduledDate])
  @@index([assignmentId, scheduledDate])
}

// ============================================================================
// TAREAS DEL FISIO
// ============================================================================

model FisioTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Tarea puede estar asociada a un lead (típico para closer/setter) en vez de un paciente.
  leadId      String?
  lead        Lead?    @relation("LeadFisioTasks", fields: [leadId], references: [id], onDelete: SetNull)

  // Plantilla de mensaje asociada a la tarea. Si está, la card muestra "📤 Enviar"
  // que ejecuta la acción de la plantilla (selector de caso → WhatsApp interpolado).
  messageTemplateId String?
  messageTemplate   MessageTemplate? @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)

  source      String   @default("own")               // "own" | "team"
  // El campo assignedBy puede ser texto libre o un ID de Professional (lo decidimos en la UI)
  assignedBy  String?
  assignedByProfessionalId String?
  assignedByProfessional   Professional? @relation("AssignedByFisio", fields: [assignedByProfessionalId], references: [id])

  // assignedTo: CSV de IDs de Professional cuando es tarea de equipo
  assignedTo  String?
  // Para queries: relación con UN profesional principal (si solo hay uno)
  assignedToProfessionalId String?
  assignedToProfessional   Professional? @relation("AssignedToFisio", fields: [assignedToProfessionalId], references: [id])

  priority    String   @default("medium")             // "low" | "medium" | "high"

  // Recurrencia
  recurrenceType  String   @default("none")           // "none" | "daily" | "weekly" | "monthly"
  recurrenceDay   Int?                                // si weekly: 1-7; si monthly: 1-31
  parentTaskId    String?

  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([completedAt])
  @@index([dueDate])
  @@index([source])
}

// ============================================================================
// SISTEMA PERSONAL DEL CEO
// Foco del mes + tareas privadas con prioridad/fecha/etiquetas/recurrencia
// + subtareas + cuaderno diario. Todo filtrado por professionalId del CEO.
// No comparte BD con WeeklyTeamTask ni TeamTaskAdHoc (esas son del equipo).
// ============================================================================

// Foco mensual del CEO. Una fila por (professionalId, year, month).
// Es texto libre de 1-3 frases que aparece en el panel y se renueva
// cada mes pulsando "definir foco del mes".
model CeoFocus {
  id              String   @id @default(cuid())
  professionalId  String
  year            Int
  month           Int                                       // 1-12
  content         String                                    // 1-3 frases
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([professionalId, year, month])
  @@index([professionalId])
}

// Etiqueta editable por el propio CEO (nombre + color hex).
model CeoTaskTag {
  id              String   @id @default(cuid())
  professionalId  String
  name            String                                    // "Negocio", "Personal", "Marketing"
  color           String                                    // hex "#F59E0B"
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  tasks           CeoTaskTagOnTask[]

  @@index([professionalId])
}

// Tarea privada del CEO.
model CeoTask {
  id              String   @id @default(cuid())
  professionalId  String
  title           String
  description     String?
  priority        String   @default("medium")               // "low" | "medium" | "high"
  dueDate         DateTime?
  completedAt     DateTime?
  // Estado de workflow más fino que completed/no:
  //  "pending" | "in_progress" | "waiting" | "done"
  // status="done" siempre va acompañado de completedAt (mismo evento, doble registro).
  status          String   @default("pending")
  waitingOnId     String?                                   // Professional.id si status="waiting"
  weeklyGoalId    String?                                   // FK opcional → CeoWeeklyGoal
  // Se toca en cada PATCH; alimenta el aviso de "cosas que se enfrían".
  lastTouchedAt   DateTime @default(now())
  // Recurrencia: al completar, el server crea otra tarea con dueDate calculada.
  recurrenceType  String   @default("none")                 // "none" | "daily" | "weekly" | "monthly"
  recurrenceDay   Int?                                      // si weekly: 1-7; si monthly: 1-31
  parentTaskId    String?                                   // si nació de una tarea recurrente, su padre
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subtasks        CeoSubtask[]
  tags            CeoTaskTagOnTask[]

  @@index([professionalId, completedAt])
  @@index([dueDate])
  @@index([waitingOnId])
  @@index([weeklyGoalId])
  @@index([lastTouchedAt])
}

// Subtarea (checklist dentro de una tarea).
model CeoSubtask {
  id              String   @id @default(cuid())
  taskId          String
  task            CeoTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title           String
  completedAt     DateTime?
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([taskId])
}

// Pivot N:M CeoTask <-> CeoTaskTag.
model CeoTaskTagOnTask {
  taskId  String
  task    CeoTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId   String
  tag     CeoTaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

// Cuaderno del día (legacy v1): una entrada por día. Sustituido por CeoNotes
// (singleton sin fecha). Lo mantenemos por compat de datos viejos.
model CeoJournalEntry {
  id              String   @id @default(cuid())
  professionalId  String
  date            DateTime
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([professionalId, date])
  @@index([professionalId, date])
}

// Notas persistentes del CEO: una sola caja por profesional, sin fecha.
// "Escribe lo que quieras, borra lo que quieras, siempre visible."
model CeoNotes {
  id              String   @id @default(cuid())
  professionalId  String   @unique
  content         String   @default("")
  updatedAt       DateTime @updatedAt
}

// Agenda del día: ítems rápidos creados desde el panel del CEO. Cada uno
// asociado a un día. La UI los pinta como los 7 "normales" del bloque
// agenda; los 3 "importantes" salen automáticamente de CeoTask con
// dueDate = ese día.
model CeoQuickAgendaItem {
  id              String   @id @default(cuid())
  professionalId  String
  date            DateTime                                  // 00:00 del día (UTC)
  content         String
  order           Int      @default(0)
  important       Boolean  @default(false)                  // true = slot 🎯 (3 superiores); false = 7 rápidas
  weeklyGoalId    String?                                   // opcional: vincula la diana a un objetivo de la semana
  carriedOver     Boolean  @default(false)                  // si viene arrastrado de un día anterior (UI lo muestra en rojo ↩)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([professionalId, date])
  @@index([weeklyGoalId])
}

// ----------------------------------------------------------------------------
// Objetivos de la semana del CEO. Máx 3 por semana ISO (order=0,1,2).
// Sirven como puente entre el foco del mes y las dianas/tareas diarias.
// Una tarea/diana puede apuntar a un weeklyGoalId.
// ----------------------------------------------------------------------------
model CeoWeeklyGoal {
  id                 String   @id @default(cuid())
  professionalId     String
  isoYear            Int
  isoWeek            Int                                    // 1-53
  title              String   @default("")
  order              Int      @default(0)                   // 0, 1, 2
  completedAt        DateTime?
  carriedFromGoalId  String?                                // si lo arrastraste de la semana anterior
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([professionalId, isoYear, isoWeek, order])
  @@index([professionalId, isoYear, isoWeek])
}

// ----------------------------------------------------------------------------
// Inbox de captura sin fricción: solo texto, sin campos obligatorios.
// Después se procesa en la planificación semanal y se convierte en CeoTask.
// ----------------------------------------------------------------------------
model CeoInboxItem {
  id              String   @id @default(cuid())
  professionalId  String
  content         String
  processedAt     DateTime?                                 // null = sin procesar
  convertedTaskId String?                                   // si se convirtió en CeoTask
  createdAt       DateTime @default(now())

  @@index([professionalId, processedAt])
}

// ----------------------------------------------------------------------------
// Preferencias personales del CEO para el sistema de revisión guiada.
// Singleton por profesional.
// ----------------------------------------------------------------------------
model CeoPreferences {
  id                   String   @id @default(cuid())
  professionalId       String   @unique
  weeklyPlanDayOfWeek  Int      @default(1)                 // 1=Lun ... 7=Dom
  cooldownDays         Int      @default(14)                // "se enfrían" tras N días sin tocar
  lastDayCloseAt       DateTime?                            // última vez que cerraste el día
  lastWeeklyPlanAt     DateTime?                            // última vez que planificaste semana
  updatedAt            DateTime @updatedAt
}

// ============================================================================
// LLAMADAS PROGRAMADAS CON PACIENTES
// ============================================================================

model ScheduledCall {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  scheduledAt DateTime?                               // null hasta que el fisio agenda la cita concreta
  type        String   @default("optimizacion")     // "optimizacion" | "renovacion"
  notes       String?
  completedAt DateTime?
  outcome     String?                                // notas posteriores al cumplir
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
  @@index([patientId])
}

// ============================================================================
// BIBLIOTECAS REUTILIZABLES (formularios y vídeos sueltos)
// ============================================================================

model FormLibrary {
  id        String   @id @default(cuid())
  name      String
  description String?
  questions String                                  // JSON: [{id, text, type, options?}]
  createdAt DateTime @default(now())
}

model VideoLibrary {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String
  description String?
  category    String   @default("Educacional")      // "Educacional", "Anatomía", "Técnica"...
  tags        String   @default("")
  createdAt   DateTime @default(now())
}

// ============================================================================
// HISTORIAL DE RENOVACIONES
// ============================================================================

// ============================================================================
// PERIODOS DE SUSCRIPCIÓN (historial)
// ============================================================================
// Cada paciente tiene una secuencia de Periodos. El periodo activo es el
// que no tiene endDate cumplido o tiene status="active". Al renovar, se
// crea un nuevo periodo (no se modifica el anterior).
//
// IMPORTANTE: mantenemos el nombre `SubscriptionRenewal` por compatibilidad
// con el código existente, aunque conceptualmente ahora representa también
// el periodo de alta inicial.
// ============================================================================

model SubscriptionRenewal {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Tipo de periodo y duración
  programType   String?                                  // "RECUPERA" | "CONSOLIDA" | "ADVANCE" | "PREVENTION"
  periodMonths  Int      @default(4)                     // duración en meses
  startDate     DateTime?                                // inicio del periodo
  endDate       DateTime?                                // fin previsto (puede moverse si hay pausas)

  // Estado
  status        String   @default("active")              // "active" | "finished" | "lost"
  // (`outcome` legado: "renewed" | "lost" | "pending" — se mapea a status para compat)
  outcome       String?                                  // legacy, no usar en código nuevo

  decidedAt     DateTime @default(now())                 // fecha en la que se registró este periodo
  amountPaid    Float?                                   // importe pagado por este periodo (€)
  notes         String?

  // Reserva de plaza: el paciente paga una señal (típ. 100€ / 1 mes)
  // para mantener plaza y acceso a la app hasta que renueve del todo.
  // Cuando el paciente hace la renovación REAL, el importe pagado por la
  // reserva se descuenta del total (`reservationConsumedAt` se setea al
  // momento de generar el link de renovación real).
  isReservation         Boolean   @default(false)
  reservationConsumedAt DateTime?

  invoices      PatientInvoice[]

  @@index([patientId])
  @@index([decidedAt])
  @@index([status])
}

model PatientSubscription {
  id                     String    @id @default(cuid())
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  productType            String    @default("prevention")
  plan                   String
  amountCents            Int
  currency               String    @default("eur")

  status                 String    @default("trialing")
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?

  scheduledStartAt       DateTime?

  stripeSubscriptionId   String?   @unique
  stripeCustomerId       String?
  stripePriceId          String?
  stripeLatestInvoiceId  String?

  originSource           String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([scheduledStartAt])
  @@index([currentPeriodEnd])
}

// ============================================================================
// MENSAJES PREFIJADOS (recursos)
// ============================================================================

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String                                  // "Bienvenida", "Recordatorio renovación"
  category    String   @default("Otros")              // "Bienvenida", "Seguimiento", "Renovación", "Alta", "Otros"
  targetRoles String   @default("[\"ceo\"]")           // JSON array de roles destinatarios: ["ceo","head_success","fisio","setter","closer"]. Multi-rol: una plantilla puede pertenecer a varios.
  body        String                                  // contenido del mensaje
  // Acción asociada al pulsar "Enviar" en una tarea con esta plantilla.
  // null = plantilla normal (copia al portapapeles). "send_success_case" = pop-up para elegir un SuccessCase y abre WhatsApp con texto interpolado.
  // Reservados para más adelante: "send_agenda", "send_meeting_reminder".
  actionType  String?
  createdAt   DateTime @default(now())

  fisioTasks  FisioTask[]
}

// ============================================================================
// CASOS DE ÉXITO (biblioteca CEO) — testimonios reales en vídeo de YouTube
// que el closer comparte con leads en plantillas con actionType="send_success_case".
// ============================================================================

model SuccessCase {
  id          String   @id @default(cuid())
  name        String                                  // "Ana"
  injury      String                                  // "rotura de supraespinoso"
  youtubeUrl  String                                  // link del vídeo
  notes       String?                                 // notas internas para el closer (no van al mensaje)
  active      Boolean  @default(true)                 // ocultar sin borrar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// TUTORIALES / FORMACIÓN INTERNA DEL EQUIPO (estilo Skool)
// Estructura de 3 niveles: Module > Section > Lesson. Las lecciones pueden
// llevar adjuntos arbitrarios (PDFs, imágenes, links).
// ============================================================================

model TrainingModule {
  id          String   @id @default(cuid())
  title       String                                  // "Onboarding de fisios"
  description String?
  coverUrl    String?                                 // imagen de portada
  order       Int      @default(0)
  published   Boolean  @default(true)                 // si false, oculto del listado
  // JSON array de roles destinatarios: ["ceo","head_success","fisio","setter","closer"].
  // Multi-rol: un módulo puede ser visible para varios roles.
  targetRoles String   @default("[\"ceo\"]")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections TrainingSection[]

  @@index([order])
}

model TrainingSection {
  id        String   @id @default(cuid())
  moduleId  String
  module    TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons TrainingLesson[]

  @@index([moduleId, order])
}

model TrainingLesson {
  id          String   @id @default(cuid())
  sectionId   String
  section     TrainingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  videoUrl    String?                                 // YouTube/Vimeo opcional
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments TrainingLessonAttachment[]

  @@index([sectionId, order])
}

model TrainingLessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind      String                                   // "pdf" | "link" | "image"
  url       String                                   // URL al recurso (Vercel Blob para PDFs/imgs, link externo para "link")
  name      String                                   // nombre visible "Guía de adaptaciones.pdf"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([lessonId, order])
}

// ============================================================================
// CHAT DE EQUIPO (estilo Slack: canales públicos, privados y DMs 1-a-1)
// ============================================================================

model ChatChannel {
  id          String   @id @default(cuid())
  // "public"  → cualquiera del equipo lo ve y postea (membership automática).
  // "private" → solo invitados (registrados en ChatMember).
  // "dm"      → conversación 1-a-1; siempre 2 ChatMember, name=null.
  kind        String
  // Para public/private: nombre del canal ("#general"). Null en DMs.
  name        String?
  // Para public/private: tema / propósito visible en el header.
  description String?
  // Emoji decorativo opcional ("💬", "🩺", "📈"...). UI usa "💬" si null.
  emoji       String?
  createdAt   DateTime @default(now())
  // Quién lo creó (para auditoría). Nullable porque si lo borramos no rompe.
  createdById String?
  // Archivado: oculto del listado pero historial accesible si alguien lo abre directo.
  archivedAt  DateTime?

  members  ChatMember[]
  messages ChatMessage[]

  @@index([kind])
}

model ChatMember {
  id             String   @id @default(cuid())
  channelId      String
  channel        ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // Cuándo se unió (informativo).
  joinedAt       DateTime @default(now())
  // Para badge de no leídos: timestamp del último mensaje que el usuario ha visto.
  // Null = nunca lo ha abierto, todo aparece como no leído.
  lastReadAt     DateTime?

  @@unique([channelId, professionalId])
  @@index([professionalId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Autor: nullable porque si se borra el profesional, conservamos el mensaje
  // con el snapshot del nombre. Snapshot de fullName para no perderlo.
  authorId    String?
  author      Professional? @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String

  body        String
  // JSON array de professionalIds mencionados con @ (resueltos en el server).
  // Se usa para crear TeamNotifications a cada mencionado.
  mentions    String   @default("[]")

  createdAt   DateTime @default(now())
  editedAt    DateTime?
  // Soft-delete: el mensaje aparece como "Mensaje eliminado" para no romper hilo.
  deletedAt   DateTime?

  @@index([channelId, createdAt])
}

// ============================================================================
// CONTENIDO PARA INSTAGRAM (planificación + ejecución + métricas)
// ============================================================================

// ============================================================================
// PLANTILLAS SEMANALES DE CONTENIDO
// ============================================================================
// El usuario puede crear N plantillas semanales reutilizables. Cada plantilla
// tiene un nombre y los 7 días (Lun-Dom), donde cada día define: título
// opcional, formato y objetivos. Al crear una nueva semana, se puede aplicar
// una plantilla concreta o crear las 7 piezas vacías.
// Editable desde /fisio/contenido/plantilla.
// ============================================================================

model WeeklyTemplate {
  id          String   @id @default(cuid())
  name        String                              // ej. "Semana educativa estándar"
  description String?                             // descripción opcional
  days        String   @default("[]")            // JSON: array de 7 objetos {dayOfWeek, title, format, goals[]}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
}

// ============================================================================
// PLANTILLAS DE GUION (reutilizables por pieza)
// ============================================================================
// Plantillas que el usuario crea libremente para reutilizar dentro de cualquier
// pieza de su mismo formato (ej. "Antes-Después-Puente" para Reels,
// "5 errores comunes" para Carruseles).
// Cada plantilla tiene: nombre, formato al que aplica, y una lista de bloques
// con sus títulos descriptivos (NO temporales).
// ============================================================================

model ScriptTemplate {
  id          String   @id @default(cuid())
  name        String                              // ej. "Antes-Después-Puente"
  format      String                              // "reel" | "carousel" | "infographic" | "image" | "live"
  blocks      String   @default("[]")            // JSON: [{id, label, order}]
  description String?                             // descripción opcional para Ales (cuándo usar)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([format])
}

model ContentWeek {
  id              String   @id @default(cuid())
  weekNumber      Int                                 // semana del año (1-53)
  year            Int
  startDate       DateTime                            // lunes
  endDate         DateTime                            // domingo

  // Briefing estratégico
  centralTheme    String                              // tema central
  bodyZone        String                              // "hombro" | "rodilla" | "lumbar" | "mixta"
  weekType        String                              // "educativa" | "objeciones" | "lanzamiento" | "recuperacion"
  limitingBeliefs String   @default("[]")             // JSON: array de strings
  leadMagnetName  String?                             // nombre del lead magnet activo (entidad propia en Entrega F)
  leadMagnetKeyword String?                           // palabra clave de DM
  commercialTrigger String?
  previousWeekConnection String?
  nextWeekSetup   String?

  // Mix objetivo (suma 100%)
  mixValue        Int      @default(50)               // % piezas de valor
  mixBeliefs      Int      @default(30)               // % piezas de creencias
  mixConversion   Int      @default(20)               // % piezas de conversión

  // KPI
  kpiName         String?                             // "DMs con palabra clave"
  kpiTarget       Float?                              // valor objetivo

  status          String   @default("planning")       // "planning" | "production" | "publishing" | "closed"

  // Aprendizajes (se rellenan al cerrar)
  closingNotes    String?                             // qué funcionó, qué no
  winningHooks    String?                             // hooks ganadores en texto libre
  ideasEmerged    String?                             // ideas surgidas

  // Historias de la semana: JSON array de 7 strings (índice 0=Lun ... 6=Dom)
  weekStories     String   @default("[]")
  // Instrucciones libres del CEO para la generación de stories de esta semana.
  // El endpoint stories-generate las inyecta en el user prompt y las trata
  // como prioritarias por encima de la estructura sugerida (Lun=pregunta,
  // Mar=mito...). Vacío = se mantiene la estructura por defecto.
  weekStoriesInstructions String? @default("")

  // PDF de estrategia/briefing de la semana (Vercel Blob). Solo CEO sube.
  strategyPdfUrl  String?
  strategyPdfName String?  // nombre original del fichero, para el link

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  closedAt        DateTime?

  pieces          ContentPiece[]

  @@index([year, weekNumber])
  @@index([status])
}

model ContentPiece {
  id              String   @id @default(cuid())
  weekId          String
  week            ContentWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek       Int                                 // 1=Lun ... 7=Dom
  format          String                              // "reel" | "carousel" | "infographic" | "image" | "live"
  title           String?                             // título libre editable; si null se muestra el label del formato
  goal            String                              // autopoblado por formato
  goals           String   @default("[]")     // JSON array de objetivos: ["atraer","educar"...]
  ctaType         String                              // autopoblado por formato
  dmKeyword       String?                             // palabra clave de DM si aplica

  hook            String?                             // hook principal
  blocks          String   @default("[]")             // JSON: [{id, label, content, order}]
  caption         String?

  // Producción
  recordingLocation String?
  recordingOutfit   String?
  recordingMaterial String?
  consentSigned     Boolean @default(false)
  assignedCaseId    String?                           // entidad propia más adelante
  finalFileUrl      String?
  editorNotes       String?

  // Estado de la pieza
  status          String   @default("idea")           // "idea" | "script" | "recorded" | "edited" | "scheduled" | "published"

  // Métricas (rellenadas tras publicar)
  metricsReach           Int?
  metricsSaves           Int?
  metricsShares          Int?
  metricsComments        Int?
  metricsLikes           Int?
  metricsDmKeyword       Int?                         // DMs recibidos con la palabra clave
  metricsConversions     Int?                         // conversiones a cliente atribuidas
  metricsFilledAt        DateTime?
  igMediaId              String?                      // post de Instagram vinculado

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weekId, dayOfWeek])
  @@index([status])
}

// ============================================================================
// BANCO DE RECURSOS: lead magnets, casos clínicos, hooks ganadores
// ============================================================================

model LeadMagnet {
  id           String   @id @default(cuid())
  name         String                                  // "Guía hombro CrossFit"
  keyword      String?                                 // palabra clave DM (ej "HOMBRO")
  description  String?
  url          String?                                 // dónde se descarga
  active       Boolean  @default(true)
  lastPromotedAt DateTime?                             // última vez que se usó en una semana
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

model ClinicalCase {
  id              String   @id @default(cuid())
  athleteName     String
  injury          String                                // "Impingement subacromial derecho"
  insight         String?                               // qué aprendí clínicamente
  consentSigned   Boolean  @default(false)
  consentSignedAt DateTime?
  videoUrls       String   @default("[]")               // JSON array de URLs
  notes           String?
  patientId       String?                               // relación opcional al paciente real si existe
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
}

model WinningHook {
  id              String   @id @default(cuid())
  text            String                                // título del hook / idea
  format          String?                               // formato sugerido
  bodyZone        String?                               // zona corporal
  weekId          String?                               // de qué semana salió (opcional)
  url             String?                               // enlace a reel/vídeo de referencia
  // (legacy, ya no se usan en la UI de hooks)
  reach           Int?
  saves           Int?
  dmKeyword       Int?
  conversions     Int?
  notes           String?                               // descripción
  createdAt       DateTime @default(now())

  @@index([format])
  @@index([bodyZone])
}

// Ideas sueltas de contenido: para apuntar cosas que se te ocurren y luego usarlas.
// Las etiquetas siguen el embudo: Atraer (top funnel) / Educar (mid) / Convertir (bottom)
model ContentIdea {
  id          String   @id @default(cuid())
  title       String                                  // título corto descriptivo
  description String?                                 // detalle de la idea
  funnelStage String   @default("educate")            // "attract" | "educate" | "convert"
  bodyZone    String?                                 // opcional: hombro/rodilla/lumbar/mixta
  suggestedFormat String?                             // opcional: belief_carousel, value_reel, etc.
  used        Boolean  @default(false)                // ya se usó en una pieza
  usedPieceId String?                                 // referencia a la pieza donde se usó
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([funnelStage])
  @@index([used])
}

// Eventos custom del calendario de contenido (masterclasses, workshops, aperturas de plazas...).
// Son anotaciones libres por fecha, no afectan a las piezas ni a las semanas.
model CalendarEvent {
  id        String   @id @default(cuid())
  date      DateTime                          // día del evento (00:00 UTC)
  title     String                            // "Masterclass hombro", "Workshop lumbar", "Apertura plazas"
  notes     String?                           // detalle opcional
  color     String   @default("neutral")      // "neutral" | "amber" | "blue" | "emerald" | "purple" | "rose"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ============================================================================
// AUTH: sesiones + códigos de login (paciente)
// ============================================================================

// Una Session = un usuario logueado en un dispositivo. La cookie del navegador
// guarda el token, que apunta aquí. Si la fila se borra → cierre de sesión.
model Session {
  id           String   @id @default(cuid())
  token        String   @unique                       // valor de la cookie
  // Solo uno de los dos: o profesional o paciente
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId    String?
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  // Metadata para auditoría
  userAgent    String?
  ipAddress    String?

  @@index([professionalId])
  @@index([patientId])
  @@index([expiresAt])
}

// Códigos de un solo uso para login del paciente (6 dígitos numéricos)
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  sentOk    Boolean?
  sentError String?
  sentTo    String?
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

// ============================================================================
// PAUSAS DE PROGRAMA (solo para programas fixed)
// ============================================================================
// Cuando un paciente se va de vacaciones / pausa el programa, registramos
// las fechas. La fecha fin de su suscripción se extiende automáticamente
// el mismo número de días que dura la pausa. Su "semana actual del programa"
// salta: la semana N se sirve después de la pausa.
//
// Regla: solo una pausa "scheduled" o "active" a la vez por paciente.
// ============================================================================

model ProgramPause {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime                       // fin originalmente previsto
  actualEndDate DateTime?                    // si la termina antes manualmente, fin real
  reason      String?                        // ej "Vacaciones", "Lesión externa"
  status      String   @default("scheduled") // "scheduled" | "active" | "ended" | "cancelled"
  daysExtended Int     @default(0)           // días gratis añadidos a la suscripción
  createdById String?                        // quién la creó (profesional)
  createdAt   DateTime @default(now())
  reminderSent Boolean @default(false)       // email "vuelves" enviado al terminar

  @@index([patientId, status])
  @@index([endDate])
}

// ============================================================================
// PROGRAMA ROLLING (tiempo corrido - solo para ADVANCE)
// ============================================================================
// Un RollingProgram es un "canal" de contenido semanal compartido (ej.
// "Rolling Strength", "Rolling Performance"). Cada semana del calendario
// tiene su contenido (RollingWeek). Pacientes ADVANCE rolling se suscriben
// a UN RollingProgram y ven la semana actual del calendario.
// ============================================================================

model RollingProgram {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  role        String   @default("")
  createdAt   DateTime @default(now())

  weeks       RollingWeek[]
  patientsLegacy     Patient[] @relation("PatientLegacyRolling")
  patientsAccessories Patient[] @relation("PatientAccessoriesRolling")
  patientsTraining    Patient[] @relation("PatientTrainingRolling")

  @@index([role])
}

model RollingWeek {
  id               String   @id @default(cuid())
  programId        String
  program          RollingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekStartDate    DateTime                   // lunes 00:00 de esa semana
  title            String?                    // "Semana del 19 mayo · Foco fuerza"
  notes            String?                    // notas internas del fisio (no visibles al paciente)
  publishedAt      DateTime?                  // null = borrador; con fecha = visible para pacientes
  createdAt        DateTime @default(now())

  days             RollingDay[]

  @@unique([programId, weekStartDate])
  @@index([weekStartDate])
}

model RollingDay {
  id          String   @id @default(cuid())
  weekId      String
  week        RollingWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek   Int                              // 1 (lunes) a 5 (viernes)
  tasks       RollingTask[]

  @@unique([weekId, dayOfWeek])
}

model RollingTask {
  id          String   @id @default(cuid())
  dayId       String
  day         RollingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  type        String
  title       String   @default("")
  order       Int      @default(0)

  bodyText    String?
  videoId     String?
  formId      String?

  exercises   RollingTaskExercise[]
  overrides   PatientRollingTaskOverride[]

  @@index([dayId])
}

model PatientRollingTaskOverride {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation("PatientRollingOverrides", fields: [patientId], references: [id], onDelete: Cascade)
  taskId        String
  task          RollingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  hidden        Boolean  @default(false)
  title         String?
  bodyText      String?
  videoId       String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([patientId, taskId])
  @@index([patientId])
}

model RollingTaskExercise {
  id          String          @id @default(cuid())
  rollingTaskId String
  rollingTask   RollingTask   @relation(fields: [rollingTaskId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    ExerciseLibrary @relation(fields: [exerciseId], references: [id])
  order       Int             @default(0)

  @@unique([rollingTaskId, exerciseId])
  @@index([rollingTaskId])
}

// ============================================================================
// VACACIONES / AUSENCIAS DEL EQUIPO
// ============================================================================
// Cuando un fisio o head success se va de vacaciones, sus pacientes RECUPERA
// y CONSOLIDA reciben +N días extra en el endDate de su periodo activo, como
// compensación por la ausencia de soporte humano.
//
// Reglas:
//  - Solo se aplica el bonus si las vacaciones duran 8+ días
//  - Días exactos (no se redondea)
//  - Solo aplica a pacientes RECUPERA y CONSOLIDA (no ADVANCE ni PREVENTION)
//  - Las sesiones del programa NO se mueven
//  - Si el paciente cambia de fisio en mitad de las vacaciones, solo recibe
//    bonus si está asignado al fisio durante las vacaciones
// ============================================================================

model ProfessionalLeave {
  id              String   @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  startDate       DateTime                        // primer día fuera
  endDate         DateTime                        // último día fuera (inclusivo)

  // Días que se sumaron a los pacientes afectados. Puede ser 0 si no aplica
  // (vacaciones < 8 días, sin pacientes asignados, etc).
  daysApplied     Int      @default(0)
  // Cuántos pacientes recibieron el bonus
  affectedPatientsCount Int @default(0)

  // Estado: "scheduled" (programada, aún no aplicada) | "applied" (bonus ya
  // sumado) | "cancelled" (cancelada, bonus revertido si lo había)
  status          String   @default("scheduled")

  // Cuándo se aplicó el bonus (cuando llegó startDate y se procesó)
  appliedAt       DateTime?
  // Cuándo se canceló (si aplica)
  cancelledAt     DateTime?

  notes           String?                         // motivo / notas internas

  // Quién creó la vacación (CEO/Head success típicamente)
  createdById     String?

  createdAt       DateTime @default(now())

  @@index([professionalId])
  @@index([startDate])
  @@index([status])
}

// ============================================================================
// NOTIFICACIONES PARA EL PACIENTE
// ============================================================================
// Avisos persistentes que aparecen en el dashboard del paciente cuando entra.
// Se marcan como leídos al pulsar "OK" y dejan de salir.
//
// Tipos usados hoy:
//  - "leave_bonus": vacaciones del fisio → días extra de regalo
// ============================================================================

// Tokens de push notifications de los pacientes (uno o varios por paciente,
// uno por dispositivo iOS/Android). Se registra desde la app móvil al abrir
// y se actualiza si cambia el token APNs/FCM.
model PatientPushToken {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  token       String                                  // APNs device token (hex string) o FCM token
  platform    String                                  // "ios" | "android"
  // bundleId: para distinguir entre la app de prod y testflight si convive.
  bundleId    String?
  // Activo: false si el envío devolvió "Unregistered" (lo desactivamos pero
  // mantenemos historial). Re-registrar al abrir la app vuelve a activarlo.
  active      Boolean  @default(true)
  lastUsedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([token])
  @@index([patientId, active])
}

model PatientNotification {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type        String                          // "leave_bonus" | (futuros)
  title       String
  body        String

  readAt      DateTime?                       // null = aún no leída
  createdAt   DateTime @default(now())
  // Notificaciones con caducidad natural (ej. "tu fisio está de vacaciones"):
  // cuando expiresAt < now, la app las oculta automáticamente aunque el
  // paciente no las haya cerrado. null = no expira.
  expiresAt   DateTime?

  @@index([patientId])
  @@index([readAt])
}

// ============================================================================
// INTEGRACIÓN GOOGLE CALENDAR
// ============================================================================
// Almacena la conexión OAuth con Google Calendar de la organización.
// Diseño: una conexión por organización (la de videoconsultas@fisiofitteam.com),
// no por usuario individual. La hace un manager (CEO/Head_success) y se
// reutiliza para todas las operaciones de la app.
//
// Los tokens se almacenan encriptados con AES-256-GCM usando ENCRYPTION_KEY.
// ============================================================================

model GoogleCalendarConnection {
  id              String   @id @default(cuid())

  // Email de la cuenta Google que se conectó (típicamente videoconsultas@fisiofitteam.com)
  googleEmail     String   @unique
  googleName      String?

  // Quién hizo la conexión inicial (CEO o Head_success)
  connectedById   String?

  // Tokens encriptados (formato: "iv:authTag:ciphertext" en hex)
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String?  @db.Text

  // Cuándo expira el access token (típicamente 1 hora desde la emisión)
  tokenExpiresAt  DateTime

  // Permisos otorgados (CSV de scopes)
  scopes          String   @default("")

  // Última vez que la app usó esta conexión (para detectar conexiones muertas)
  lastUsedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// CALENDARIO DE LLAMADAS (FRANJAS DE COBERTURA)
// ============================================================================
// Cada semana, CEO/Closer/Setter definen qué franjas horarias cubre cada
// closer. Esto permite que cuando un lead agende en Calendar (en sesión 3),
// la app sepa automáticamente a qué closer asignarle.
//
// Modelo: por semana concreta (no patrón abstracto). Botón "Copiar semana
// anterior" facilita la repetición.
//
// Una franja = un closer cubriendo un tramo horario un día concreto:
//   weekStartDate=lunes 26may, dayOfWeek=1 (L), 09:00–14:00, closer=Alba
// ============================================================================

model ClosingShift {
  id              String   @id @default(cuid())

  // Lunes 00:00 de la semana a la que pertenece la franja
  weekStartDate   DateTime

  // Día de la semana: 1=L, 2=M, 3=X, 4=J, 5=V, 6=S, 7=D
  dayOfWeek       Int

  // Hora en formato "HH:MM" (24h). Ej: "09:00", "14:30"
  startTime       String
  endTime         String

  // Closer que cubre esta franja (FK a Professional)
  closerId        String
  closer          Professional @relation("ClosingShifts", fields: [closerId], references: [id], onDelete: Cascade)

  // Notas internas (opcional)
  notes           String?

  // Duración del slot en minutos para esta semana (override de la duración
  // global de la plantilla). Default 60.
  slotDurationMinutes Int     @default(60)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weekStartDate, dayOfWeek])
  @@index([closerId])
}

// ============================================================================
// NOTIFICACIONES IN-APP PARA EL EQUIPO
// ============================================================================
// Cuando un lead agenda desde la landing, o cuando se dispara una etapa del
// flujo comercial (avisado, recordatorio del día siguiente, etc), se generan
// notificaciones para los miembros del equipo correspondientes.
//
// Flujo de etapas:
//  1. Lead agenda → notificación "lead_new" para todos los SETTERS
//  2. Setter marca "avisado" → notificación "lead_assigned" para el CLOSER asignado
//  3. Cron 09:00 día anterior → notificación "call_reminder" para el CLOSER
//
// Las notificaciones se marcan como leídas (readAt) cuando el destinatario
// pulsa "OK" en su campanita o cuando completa la acción asociada.
// ============================================================================

model TeamNotification {
  id              String   @id @default(cuid())

  // A quién va dirigida. Si es a un rol completo (ej. todos los setters),
  // se rellena targetRole. Si es a un profesional concreto, targetProfessionalId.
  // Pueden ir ambos rellenos: "para el rol setter PERO concretamente Niki".
  targetRole          String?    // "setter" | "closer" | "ceo" | etc.
  targetProfessionalId String?   // FK Professional (si va a uno concreto)

  // Tipo de notificación (clave estable para el código)
  // - "lead_new": lead nuevo entró por landing, esperando primer contacto
  // - "lead_assigned": el setter ya avisó, el closer debe contactar
  // - "call_reminder": recordatorio del día anterior para enviar recordatorio + video
  type            String

  // Lead relacionado (todas las notificaciones actuales van ligadas a un Lead)
  leadId          String?

  // Texto visible
  title           String
  body            String

  // Acción CTA opcional (URL relativa a la que el botón redirige)
  actionUrl       String?

  // Clave estable para deduplicar notificaciones generadas por estado
  // (p. ej. "program_ending:<assignmentId>"). null en las basadas en evento.
  refKey          String?

  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([targetRole, readAt])
  @@index([targetProfessionalId, readAt])
  @@index([leadId])
  @@index([refKey])
}

// ============================================================================
// PLANTILLA POR DEFECTO DEL CALENDARIO DE LLAMADAS
// ============================================================================
// Plantilla que se aplica a TODAS las semanas a menos que la semana concreta
// tenga overrides (ver WeekOverride más abajo).
//
// La landing pública /agenda usa esta plantilla (o los overrides) como
// fuente de verdad para los slots disponibles.
//
// Las franjas son en HORA DE MADRID. Ejemplo: L 18-20 = Alba.
// ============================================================================

model DefaultClosingShift {
  id                  String   @id @default(cuid())
  dayOfWeek           Int                                          // 1=L, 2=M, ..., 7=D
  startTime           String                                       // "HH:MM"
  endTime             String                                       // "HH:MM"
  closerId            String
  closer              Professional @relation(fields: [closerId], references: [id])
  // Duración del slot en minutos. Valor por defecto 60.
  // Aunque es un campo por franja, en UI lo gestionamos como global (todas las
  // franjas de la plantilla comparten el mismo valor). Almacenarlo aquí evita
  // crear una tabla aparte de configuración.
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([closerId])
}

// ============================================================================
// OVERRIDE DE SEMANA CONCRETA
// ============================================================================
// Indica si una semana usa la plantilla por defecto (default) o tiene franjas
// personalizadas en ClosingShift.
//
// Cuando se edita una franja en una semana concreta, se crea automáticamente
// un WeekOverride con useDefault=false y se copian las franjas actuales de
// la plantilla a ClosingShift.
// ============================================================================

model WeekOverride {
  id              String   @id @default(cuid())
  weekStartDate   DateTime @unique                         // lunes 00:00 de esa semana
  useDefault      Boolean  @default(true)                  // true=plantilla, false=overrides
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weekStartDate])
}

// ============================================================================
// BLOQUEOS PUNTUALES
// ============================================================================
// Días o franjas concretos bloqueados (vacaciones, indisposición, festivos...).
// Pueden ser:
//  - Día entero: blockedStartTime/blockedEndTime null
//  - Franja concreta: blockedStartTime/blockedEndTime con HH:MM
//
// La landing los detecta y los descarta de los slots disponibles.
// ============================================================================

model AgendaBlock {
  id                String    @id @default(cuid())
  blockedDate       DateTime                                  // fecha bloqueada (YYYY-MM-DD a las 00:00 Madrid)
  blockedStartTime  String?                                   // "HH:MM" o null (= todo el día)
  blockedEndTime    String?                                   // "HH:MM" o null
  reason            String?                                   // "Vacaciones", "Festivo", ...
  createdBy         String?                                   // Professional.id que lo creó
  createdAt         DateTime  @default(now())

  @@index([blockedDate])
}

// ============================================================================
// SALE - VENTAS / PAGOS DE PROGRAMAS
// ============================================================================
// Cada venta de un programa (RECUPERA / CONSOLIDA) genera un Sale.
//
// Flujo:
//   1. Closer cierra lead en videollamada
//   2. Closer pulsa "Generar link de pago" en la ficha del lead → crea Sale
//      con status="pending" y paymentToken único
//   3. Lead abre URL /pagar/[token] → landing branded
//   4. Lead paga en Stripe Checkout
//   5. Webhook Stripe → marca Sale status="paid"
//   6. Tras crear cuenta y entrar a la app, se crea Patient y se vincula al Sale
// ============================================================================

model Sale {
  id          String   @id @default(cuid())

  // Origen: el lead que se cierra en videollamada
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])

  // Closer que generó el link (auditoría)
  closerId    String
  closer      Professional @relation("SaleByCloser", fields: [closerId], references: [id])

  // Paciente creado tras pagar (null hasta que paga)
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])

  // ─── Producto comprado ──────────────────────────────────────────────────
  productCode    String                       // "RECUPERA_4M" | "RECUPERA_6M" | "CONSOLIDA_4M" | "CONSOLIDA_6M"
  programType    String                       // "RECUPERA" | "CONSOLIDA"
  durationMonths Int                          // 4 | 6

  // ─── Stripe ─────────────────────────────────────────────────────────────
  stripeSessionId         String?  @unique
  stripePaymentIntentId   String?
  stripePriceId           String?                       // price_xxx de Stripe (null si duración custom sin priceId fijo)
  amountCents             Int                           // en céntimos (60000 = 600€)
  currency                String   @default("eur")
  paymentMethod           String?                       // "card" | "klarna" | "paypal" | "paypal_paylater" | null

  // ─── PayPal ─────────────────────────────────────────────────────────────
  paypalOrderId           String?  @unique
  paypalCaptureId         String?
  // Suscripción PayPal para pago fraccionado en N cuotas mensuales
  paypalSubscriptionId    String?  @unique
  paypalPlanId            String?
  // Si null/0 → pago único. Si 2..12 → N cobros mensuales del mismo importe.
  installmentCount        Int?

  // ─── Estado de la venta ─────────────────────────────────────────────────
  // "pending"  → link generado, todavía no pagado
  // "paid"     → pago completado correctamente
  // "failed"   → intento de pago fallido (puede reintentarse)
  // "refunded" → reembolsado
  // "expired"  → token expiró sin pago
  status      String   @default("pending")
  paidAt      DateTime?

  // ─── Refund (devolución) ────────────────────────────────────────────────
  // Cuando el CEO devuelve un pago desde la ficha del paciente:
  //  - refundedAt: momento en que se marcó devuelto en nuestra BD
  //  - refundReason: motivo interno (obligatorio)
  //  - refundedByProfessionalId: quién lo ejecutó (audit trail)
  //  - refundedManually: true si el CEO ya lo había devuelto en PayPal a mano
  //    y sólo queríamos marcar en la BD (no se llamó a la API de PayPal)
  refundedAt                DateTime?
  refundReason              String?
  refundedByProfessionalId  String?
  refundedBy                Professional? @relation("SaleRefundedBy", fields: [refundedByProfessionalId], references: [id])
  refundedManually          Boolean  @default(false)

  // ─── Token único para la landing ────────────────────────────────────────
  // El cliente recibe URL del tipo /pagar/[paymentToken]
  paymentToken    String   @unique
  tokenExpiresAt  DateTime

  // Datos extra del formulario "Nuevo paciente" cuando el Sale se generó
  // desde el alta manual (botón "Generar link de pago Stripe"). JSON
  // serializado con campos opcionales: assignedProfessionalId, diagnosis,
  // programMode ("fixed"|"rolling"), rollingProgramId.
  // Se aplican al Patient al ejecutarse el webhook Stripe — así el alta
  // queda con el fisio asignado y el diagnóstico que metió el CEO en el
  // form, en vez de recrearse con valores por defecto.
  // Para Sales venidos de la agenda de leads este campo es null.
  manualAltaData  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    PatientInvoice[]

  @@index([leadId])
  @@index([patientId])
  @@index([status])
  @@index([paymentToken])
}

// Configuración editable del onboarding (fila única, id = "singleton").
// Si no existe, el código cae a los valores por defecto de lib/onboarding-content.ts.
model OnboardingConfig {
  id              String   @id @default("singleton")
  anamnesisSteps  String                              // JSON: AnamnesisStep[]
  contractText    String
  contractVersion String
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// Enlace de pago de RENOVACIÓN (paciente existente). Mismo patrón que Sale pero
// vinculado al Patient y con precio definido al vuelo. Al pagar, el webhook crea
// el SubscriptionRenewal correspondiente.
model RenewalCheckout {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdById   String?                              // profesional que generó el enlace

  programType    String                              // "RECUPERA" | "CONSOLIDA" | "ADVANCE"
  durationMonths Int
  amountCents    Int                                 // importe definido al generar el enlace
  currency       String   @default("eur")

  stripeSessionId       String?  @unique
  stripePaymentIntentId String?
  paymentMethod         String?

  // PayPal (Fase 3): pago único o suscripción con N cuotas mensuales
  paypalOrderId         String?  @unique
  paypalCaptureId       String?
  paypalSubscriptionId  String?  @unique
  paypalPlanId          String?
  installmentCount      Int?     // null/1 → pago único; 2..12 → N cuotas

  // Reserva de plaza: señal para mantener el sitio hasta que renueve del
  // todo. Solo permite 1 pago (installmentCount se ignora), y el
  // SubscriptionRenewal que se crea al pagar hereda este flag.
  isReservation Boolean  @default(false)

  status        String   @default("pending")         // "pending" | "paid" | "failed" | "expired"
  paidAt        DateTime?
  renewalId     String?                              // SubscriptionRenewal creado al pagar

  paymentToken   String   @unique
  tokenExpiresAt DateTime

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
  @@index([status])
}

// Copy editable de las landings (clave = identificador de la landing, p.ej.
// "renewal"). content es JSON con los campos de texto. Si no existe, el código
// cae a los valores por defecto de lib/landing-content.ts.
model LandingConfig {
  id          String   @id                            // "renewal" | "contract" | ...
  content     String                                  // JSON con los campos de copy
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Mensaje de bienvenida de la home del paciente (fila única). content es JSON:
// { rules: [...], fallbackLine1, fallbackLine2 }. Defaults en lib/welcome-content.ts.
model WelcomeMessageConfig {
  id          String   @id @default("singleton")
  content     String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Factura emitida al paciente. Numeración correlativa por año (FF-2026-0001).
// Los datos del cliente y emisor se guardan como SNAPSHOT (no FK) porque una
// factura emitida no puede cambiar si luego editas el perfil del paciente o el
// tuyo. Cumplimiento legal: facturas son inmutables.
//
// La numeración se asigna en transacción al crear (FOR UPDATE-ish con retry en
// caso de carrera, ver lib/patient-invoices.ts).
model PatientInvoice {
  id              String    @id @default(cuid())

  // Numeración (asignada al crear, nunca cambia)
  series          String    @default("FF")
  year            Int
  sequence        Int
  number          String    @unique             // "FF-2026-0001"

  // Fechas
  issueDate       DateTime                       // fecha de emisión

  // ─── Cliente (snapshot, NO se actualiza si el paciente cambia datos) ───
  patientId       String?
  patient         Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clientName      String                         // fullName del paciente
  clientTaxId     String?                        // contractDNI
  clientAddress   String?                        // dirección completa formateada
  clientEmail     String?

  // ─── Emisor (snapshot del Professional CEO al momento de emitir) ───
  issuerName      String
  issuerTaxId     String?
  issuerAddress   String?
  issuerIban      String?

  // ─── Importe ───
  concept         String                         // ej. "Servicios de fisioterapia · Programa RECUPERA 4 meses"
  baseAmount      Float                          // base imponible
  vatExempt       Boolean   @default(true)       // exenta IVA art. 20 Ley 37/1992
  vatRate         Float     @default(0)          // 0 si exenta
  vatAmount       Float     @default(0)
  irpfRate        Float     @default(0)          // 0 para particulares, % si empresa retiene
  irpfAmount      Float     @default(0)
  totalAmount     Float                          // baseAmount + vatAmount - irpfAmount

  // ─── Vinculación opcional al cobro de origen (trazabilidad) ───
  saleId                String?
  sale                  Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  subscriptionRenewalId String?
  subscriptionRenewal   SubscriptionRenewal? @relation(fields: [subscriptionRenewalId], references: [id], onDelete: SetNull)
  transactionId         String?              // si vino de transacción manual

  // ─── Anulación ───
  cancelledAt        DateTime?                   // si anulada, fecha
  cancellationReason String?

  createdAt       DateTime  @default(now())
  createdById     String?                        // CEO que emitió

  @@unique([year, sequence])                     // unicidad fuerte del correlativo
  @@index([patientId])
  @@index([year, sequence])
  @@index([issueDate])
}

// Brief para la IA de generación de contenido (fila única, editable por CEO).
// Es el "system prompt" personalizado que define quién eres, cómo hablas y qué
// quieres / no quieres que la IA produzca. Se inyecta en cada llamada a Opus.
// Brief metodológico del equipo de fisioterapia para la sugerencia IA de
// control de cargas. Singleton. Lo editan los managers desde Biblioteca.
// Contenido: reglas tipo "RPE<7 dos semanas → +5%", "dolor>4 → mantener",
// rojos absolutos, plantilla de progresión, etc.
model LoadReviewBrief {
  id              String   @id @default("singleton")
  // Texto libre con las reglas/metodología. Va literal al system prompt.
  methodology     String   @default("")
  // Reglas duras de seguridad (rojos absolutos) que la IA NUNCA debe ignorar.
  hardRules       String   @default("")
  // Ejemplos de propuestas que les han salido bien (few-shot).
  goodExamples    String   @default("")
  // PDF adjunto opcional. Se sube a Vercel Blob y se pasa a Anthropic como
  // `document` con prompt caching (se cobra solo la primera vez por hora).
  briefPdfUrl     String?
  briefPdfName    String?
  briefPdfSize    Int?
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// Registro de cada vez que la IA sugiere un control de cargas y qué hizo el
// fisio con la propuesta. Útil para auditoría legal (qué propuso vs qué
// aplicó), KPI de adopción y futuro fine-tuning del prompt.
model LoadReviewRecord {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId    String   // quién pidió la sugerencia
  professional      Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  aiModel           String                       // "claude-sonnet-4-6" | "claude-opus-4-7"
  aiSuggestion      String                       // JSON: { resumenEstado, propuesta, razonamiento, flags[], alternativas[] }
  aiInputTokens     Int?
  aiOutputTokens    Int?

  // Decisión del fisio: "apply" (tal cual) | "edit" (modificó) | "ignore" (descartó)
  decision          String?
  // Lo que finalmente se aplicó (si decision=edit, aquí va el texto editado).
  appliedNotes      String?
  decidedAt         DateTime?

  createdAt         DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([professionalId, createdAt])
}

model AiContentBrief {
  id              String   @id @default("singleton")
  brand           String   @default("")   // quiénes sois, valores, posicionamiento
  voiceTone       String   @default("")   // cómo habláis: tuteo, registro, expresiones
  dos             String   @default("")   // qué SÍ hacer siempre
  donts           String   @default("")   // qué NO hacer jamás
  structureHints  String   @default("")   // patrones de ritmo fuera de las plantillas oficiales
  goodExamples    String   @default("")   // 2-3 guiones que clavasteis (con notas)
  badExamples     String   @default("")   // 2-3 ejemplos AI-slop que NO quiere
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// Brief IA específico para Anuncios de pago. Mismo modelo que AiContentBrief
// pero separado porque la voz / la estructura de un Reel orgánico no es la
// misma que la de un Ad de Meta. El campo `systemPrompt` permite pegar
// directamente el system prompt completo de la Skill de Claude del usuario.
model AiAdsBrief {
  id              String   @id @default("singleton")
  systemPrompt    String   @default("")   // OPCIONAL: pega aquí el prompt completo de tu Skill de Claude para usar exactamente esa configuración. Si está vacío, se usan los campos de abajo.
  brand           String   @default("")
  voiceTone       String   @default("")
  dos             String   @default("")
  donts           String   @default("")
  structureHints  String   @default("")
  goodExamples    String   @default("")
  badExamples     String   @default("")
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// Brief de estilo para generar sesiones ADVANCE con IA. Singleton editable
// por el CEO/head_success desde /fisio/advance/brief-ia.
model AiTrainingBrief {
  id              String   @id
  systemPrompt    String   @default("")
  philosophy      String   @default("")
  voiceTone       String   @default("")
  structureHints  String   @default("")
  formats         String   @default("")
  intensityRules  String   @default("")
  vocabulary      String   @default("")
  dos             String   @default("")
  donts           String   @default("")
  goodExamples    String   @default("")
  badExamples     String   @default("")
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

// Banco de sesiones históricas de ADVANCE cargadas desde un HTML del CEO.
// El generador las usa como few-shot para mantener el estilo.
model AiSessionExample {
  id            String   @id @default(cuid())
  kind          String   @default("accesorios")
  source        String   @default("html-import")
  weekNumber    Int?
  dayNumber     Int?
  title         String
  summary       String   @default("")
  focusTags     String   @default("")
  description   String?
  blocksJSON    String   @default("[]")
  exerciseNames String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind])
  @@index([title])
  @@index([focusTags])
}

// Reuniones → Sesiones clínicas: tabla viva de casos clínicos que el equipo
// comenta cada semana. assignedToId es el id del Professional (sin relación FK).
model ClinicalSessionCase {
  id                String   @id @default(cuid())
  patientId         String   @unique                    // un caso por paciente
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status            String   @default("pendiente")      // "pendiente" | "supervision" | "resuelto"
  situation         String?                             // descripción de la situación
  proposedSolutions String?                             // soluciones propuestas
  consensusSolution String?                             // solución consensuada
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

// Comunidad: calendario de contenido interno del programa (independiente del de
// redes). Un post por día. category: entretener|conectar|ayudar|educar|convertir.
model CommunityPost {
  id           String   @id @default(cuid())
  date         DateTime @unique                          // día del post (UTC midnight)
  category     String                                    // categoría legacy (primera de categories)
  categories   String   @default("[]")                   // JSON array — permite varias etiquetas por día
  assignedToId String?                                   // fisio que publica (manual)
  text         String?                                   // idea / contenido del día
  note         String?                                   // nota de temática del post (opcional)
  done         Boolean  @default(false)
  notifiedAt   DateTime?                                 // fecha en que el cron avisó al fisio (evita duplicados)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

// Banco de ideas de contenido de comunidad, clasificadas por categoría.
// Al programar una idea, se marca used=true y se crea un CommunityPost.
model CommunityIdea {
  id          String   @id @default(cuid())
  categories  String   @default("[]")              // JSON array de categorías
  text        String
  used        Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([used])
}

// ============================================================================
// CARRUSEL MAKER — biblioteca de referencia + drafts generados por IA
// ============================================================================
// Filosofía: para que la IA no suene a IA, la alimentamos con carruseles
// REALES ya publicados por el equipo. Cada CarouselLibraryEntry es un
// carrusel publicado (guardado por slide + caption) que sirve como few-shot
// para el generador. Al pedir un nuevo carrusel, elegimos los N más
// parecidos al brief y los pasamos a Sonnet como referencia de tono.
// ============================================================================

model CarouselLibraryEntry {
  id          String   @id @default(cuid())
  topic       String                                // "dolor hombro atletas crossfit"
  category    String?                               // "errores" | "caso_clinico" | "educativo" | "mito" | "frustracion" | otro
  slidesJson  String                                // JSON [{ n, title?, subtitle?, body?, note? }]
  captionText String?                               // pie del post en Instagram
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// Plantillas visuales — un slide guardado para reutilizar su estilo (fondo,
// tipografías, layout de elementos). Al aplicar una plantilla a un slide,
// se copian los elementos ajustando el contenido de texto al del slide
// destino. Cada equipo comparte las plantillas.
model CarouselVisualTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  slideJson    String
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// Draft generado por la IA (o creado a mano). Al "publicarlo" el user puede
// promoverlo también a CarouselLibraryEntry para que enriquezca la biblioteca.
model Carousel {
  id          String   @id @default(cuid())
  title       String                                // etiqueta libre para el listado
  brief       String                                // brief que el user escribió al generar
  category    String?                               // misma taxonomía que biblioteca
  slidesJson  String                                // JSON de slides
  captionText String?                               // pie del post en IG (generado o editado)
  visualJson  String?                               // JSON con layout+overrides visuales por slide
  status      String   @default("draft")            // draft | published | archived
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// COMUNIDAD CARA AL PACIENTE (tipo Skool): clases en módulos, vídeos cortos y
// muro de posts con comentarios/reacciones. Distinto del calendario interno
// de arriba (CommunityPost / CommunityIdea = "Plan de contenido interno").
// ============================================================================

// Módulo de clases del programa (agrupa lecciones).
// Curso del Classroom (la "tarjeta" con portada). Agrupa secciones.
model CommunityModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  order       Int      @default(0)
  published   Boolean  @default(true)              // visible para pacientes
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    CommunitySection[]

  @@index([order])
}

// Sección dentro de un curso (grupo colapsable de lecciones).
model CommunitySection {
  id        String   @id @default(cuid())
  moduleId  String
  module    CommunityModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons   CommunityLesson[]

  @@index([moduleId, order])
}

// Lección dentro de una sección (vídeo YouTube/Vimeo + descripción).
model CommunityLesson {
  id          String   @id @default(cuid())
  sectionId   String
  section     CommunitySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  videoUrl    String                              // enlace YouTube/Vimeo
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress    CommunityLessonProgress[]

  @@index([sectionId, order])
}

// Post del muro de la comunidad. Autor = profesional o paciente (uno de los dos).
model CommunityFeedPost {
  id              String   @id @default(cuid())
  authorId        String?
  author          Professional? @relation("FeedPostAuthor", fields: [authorId], references: [id])
  patientAuthorId String?
  patientAuthor   Patient? @relation("FeedPostPatientAuthor", fields: [patientAuthorId], references: [id], onDelete: Cascade)
  category        String   @default("general")     // ver lib/community-feed.ts
  title           String?
  body            String
  imageUrl        String?
  videoUrl        String?
  pinned          Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments    CommunityComment[]
  reactions   CommunityReaction[]

  @@index([pinned, createdAt])
  @@index([category])
}

// Comentario en un post. Autor = paciente o profesional (uno de los dos).
model CommunityComment {
  id             String   @id @default(cuid())
  postId         String
  post           CommunityFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation("FeedCommentAuthor", fields: [professionalId], references: [id])
  body           String
  imageUrl       String?
  parentId       String?
  parent         CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        CommunityComment[] @relation("CommentReplies")
  createdAt      DateTime @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

// Reacción ("me gusta") a un post. Única por usuario y post.
model CommunityReaction {
  id             String   @id @default(cuid())
  postId         String
  post           CommunityFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation("FeedReactionAuthor", fields: [professionalId], references: [id])
  type           String   @default("like")
  createdAt      DateTime @default(now())

  @@unique([postId, patientId])
  @@unique([postId, professionalId])
}

// Progreso de un paciente en una lección (marcada como completada).
model CommunityLessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      CommunityLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([lessonId, patientId])
  @@index([patientId])
}

// ============================================================================
// TAREAS SEMANALES DEL EQUIPO (panel principal de fisios y head_success)
// ============================================================================
// El CEO configura tareas recurrentes que aparecen cada semana en el panel
// principal de los fisios y del head_success. Cada tarea va asignada a un día
// y un rol. Las completaciones se trackean por semana → cada lunes 00:00
// Madrid las tareas vuelven a aparecer "pendientes" (sin reset real en BD: la
// vista filtra por weekStartDate). Historial completo para auditoría del CEO.
//
// targetRole: "fisio" | "head_success" (singular por ahora).
// dayOfWeek:  1..5 (L..V).
// ============================================================================

model WeeklyTeamTask {
  id          String   @id @default(cuid())
  title       String                              // "Pasar feedback", "Soporte", ...
  dayOfWeek   Int                                 // 1=L, 2=M, 3=X, 4=J, 5=V
  targetRole  String                              // "fisio" | "head_success"
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions WeeklyTeamTaskCompletion[]

  @@index([targetRole, dayOfWeek, order])
}

model WeeklyTeamTaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  task           WeeklyTeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional   @relation("WeeklyTeamTaskCompletions", fields: [professionalId], references: [id], onDelete: Cascade)
  // Lunes 00:00 UTC de la semana Madrid en la que se marcó (misma técnica que
  // weekStartDate() de lib/program-pauses).
  weekStartDate  DateTime
  completedAt    DateTime @default(now())

  @@unique([taskId, professionalId, weekStartDate])
  @@index([weekStartDate, professionalId])
}

// Tareas puntuales: cadencia mensual (día X de cada mes) o rango libre de
// fechas. Se crean desde /fisio/tareas (CEO + head_success). Aparecen en el
// panel "Tareas" del rol destinatario.
//
// kind:
//   "monthly" → dayOfMonth (1..31). Cada mes es una instancia; se considera
//               completada para ese mes si hay TeamTaskAdHocCompletion con
//               occurrenceDate = primer día del mes UTC.
//   "range"   → startDate, endDate (inclusivos). Una sola instancia, vigente
//               mientras hoy esté dentro del rango. occurrenceDate = startDate.
// kind:
//   "monthly"         → dayOfMonth (1..31). Cada mes una instancia.
//   "monthly_weekday" → nthWeek (1..4 ó -1=último) + dayOfWeek (1=L..7=D).
//                       Ej. 1er lunes / 3er viernes / último jueves.
//   "range"           → startDate, endDate (inclusivos).
// assigneesJson: JSON array de Professional.id; "[]" = todos los del role.
model TeamTaskAdHoc {
  id            String   @id @default(cuid())
  title         String
  description   String?                               // notas/instrucciones opcionales
  targetRole    String                                // "fisio" | "head_success"
  kind          String                                // "monthly" | "monthly_weekday" | "range"
  dayOfMonth    Int?
  nthWeek       Int?                                  // 1..4 ó -1
  dayOfWeek     Int?                                  // 1=L..7=D
  startDate     DateTime?
  endDate       DateTime?
  assigneesJson String   @default("[]")
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  completions   TeamTaskAdHocCompletion[]

  @@index([targetRole, active])
}

model TeamTaskAdHocCompletion {
  id             String   @id @default(cuid())
  taskId         String
  task           TeamTaskAdHoc @relation(fields: [taskId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional   @relation("TeamTaskAdHocCompletions", fields: [professionalId], references: [id], onDelete: Cascade)
  // Para monthly: primer día del mes (UTC). Para range: startDate de la tarea.
  occurrenceDate DateTime
  completedAt    DateTime @default(now())

  @@unique([taskId, professionalId, occurrenceDate])
  @@index([occurrenceDate, professionalId])
}

// Datos manuales mensuales del cuadro de mandos (seguidores, inversión ADS).
model BusinessMonthlyInput {
  id             String   @id @default(cuid())
  year           Int
  month          Int                                   // 0-11
  newFollowers   Int?
  adsSpend       Float?
  adsConversion  Float?
  totalFollowers Int?
  refunds        Int?
  updatedAt      DateTime @updatedAt

  @@unique([year, month])
}

// Objetivos trimestrales por métrica del cuadro de mandos.
model BusinessQuarterlyGoal {
  id        String   @id @default(cuid())
  year      Int
  quarter   Int                                        // 1-4
  metricKey String
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([year, quarter, metricKey])
}

// Clasificación de campañas de Meta Ads en el cuadro de mandos.
model AdCampaignTag {
  id         String   @id @default(cuid())
  campaignId String   @unique
  bucket     String                                  // "follow" | "conversion"
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// ANUNCIOS DE PAGO (gestión completa: Campaign → AdSet → Ad)
// Espejo de la estructura de Meta Ads Manager. Solo CEO gestiona.
// AdCampaignTag (más arriba) seguirá funcionando como clasificación rápida de
// las campañas devueltas por la Graph API; AdCampaign es la entidad propia que
// el equipo edita aquí dentro y se enlaza opcionalmente con su campaña en Meta
// vía metaCampaignId. Lo mismo para AdSet y Ad.
// ============================================================================

model AdCampaign {
  id              String   @id @default(cuid())
  name            String                                    // "Hombro Q3 2026"
  // Objetivo de la campaña, alineado con los objetivos de Meta:
  // "traffic" | "conversions" | "leads" | "engagement" | "awareness" | "video_views"
  objective       String   @default("conversions")
  // Estado global de la campaña en NUESTRO sistema (puede divergir del de
  // Meta hasta que sincronicemos). Workflow:
  // "idea" | "active" | "paused" | "finished"
  status          String   @default("idea")
  metaCampaignId  String?                                   // ID en Meta cuando esté creada allí
  startDate       DateTime?
  endDate         DateTime?
  dailyBudget     Float?                                    // EUR
  totalBudget     Float?
  notes           String?                                   // notas internas para el equipo
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adSets          AdSet[]

  @@index([status])
  @@index([metaCampaignId])
}

model AdSet {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name            String                                    // "Hombros 25-45 ES"
  // Criterios libres de audiencia en JSON: edad, intereses, ubicación, lookalike, etc.
  audienceJSON    String   @default("{}")
  // Placements: ["feed_ig","reels_ig","stories_ig","feed_fb",...]
  placementJSON   String   @default("[]")
  metaAdsetId     String?
  startDate       DateTime?
  endDate         DateTime?
  dailyBudget     Float?                                    // EUR
  status          String   @default("idea")                 // mismo workflow que AdCampaign
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ads             Ad[]

  @@index([campaignId])
  @@index([status])
  @@index([metaAdsetId])
}

model Ad {
  id              String   @id @default(cuid())
  adsetId         String
  adset           AdSet @relation(fields: [adsetId], references: [id], onDelete: Cascade)

  name            String                                    // "Hombro Reel Ana 30s"
  format          String   @default("video")                // "video" | "image" | "carousel" | "story"

  // Creatividad — equivalentes a ContentPiece pero específicos de pago
  hook            String?
  script          String?                                   // copy/guion completo
  cta             String?                                   // texto del CTA ("Reserva videoconsulta")
  ctaUrl          String?                                   // URL del CTA (donde pegamos UTMs antes de subir a Meta)
  finalFileUrl    String?                                   // vídeo/imagen final
  editorNotes     String?

  // Producción (igual que en ContentPiece)
  recordingLocation String?
  recordingOutfit   String?
  recordingMaterial String?
  consentSigned     Boolean @default(false)

  // Estado de workflow completo:
  // "idea" | "brief" | "recording" | "editing" | "scheduled" | "active" | "paused" | "finished"
  status          String   @default("idea")
  metaAdId        String?                                   // se rellena cuando se publica en Meta

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([adsetId])
  @@index([status])
  @@index([metaAdId])
}

// Banco específico para ads. Separado del de Contenido orgánico — los hooks y
// audiencias suelen ser distintos.
model AdHook {
  id          String   @id @default(cuid())
  text        String                                        // "¿Te cuesta dormir del lado del hombro?"
  notes       String?                                       // contexto o resultado conocido
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdAudience {
  id          String   @id @default(cuid())
  name        String                                        // "Crossfit hombro 30-45 ES"
  description String                                        // criterios libres en texto
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Plantillas de workout guardadas en la Biblioteca. Reutilizables al crear un
// workout dentro del calendario de un paciente.
model WorkoutTemplate {
  id          String   @id @default(cuid())
  title       String
  bodyText    String   @default("")           // bloque libre del WOD
  exerciseIds String   @default("[]")         // JSON: ids de ExerciseLibrary vinculados
  createdById String?                         // profesional que la creó (auditoría)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// PRs (récords personales) del paciente — exclusivo del panel ADVANCE rolling.
// El paciente los gestiona desde su app (autoeditar).
model PatientPR {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String                                  // "Snatch", "Fran", "Back Squat", "Murph"...
  value       String                                  // "100 kg", "3:21", "12 rounds"
  unit        String?                                 // opcional ("kg", "tiempo", "reps")
  recordedAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  @@index([patientId, recordedAt])
}

// Log diario del paciente — los ADVANCE rolling registran cómo les fue tras
// entrenar. 3 valores 0-10: fatiga (subjetiva al inicio), rpe (esfuerzo
// percibido de la sesión), sleep (calidad del sueño la noche anterior).
// Una entrada por paciente/día (upsert por recordedDate = UTC midnight del
// día calendario Madrid).
model PatientDailyLog {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedDate DateTime                                 // UTC midnight del día Madrid
  fatigue      Int                                       // 0..10
  rpe          Int                                       // 0..10
  sleep        Int                                       // 0..10
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([patientId, recordedDate])
  @@index([patientId, recordedDate])
}

// Reto mensual — un reto global por mes, configurable por el coach. Cada paciente
// ADVANCE rolling envía su resultado y se construye un leaderboard.
model MonthlyChallenge {
  id          String   @id @default(cuid())
  year        Int
  month       Int                                     // 0..11
  title       String                                  // "Fran sub-4"
  description String?                                 // descripción / reglas
  // Unidad para ordenar el leaderboard: "time" (menor mejor) o "kg/reps/score" (mayor mejor)
  metric      String   @default("score")              // "time" | "score"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  results     MonthlyChallengeResult[]

  @@unique([year, month])
}

// Resultado de un paciente en un reto mensual.
model MonthlyChallengeResult {
  id          String   @id @default(cuid())
  challengeId String
  challenge   MonthlyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  value       String                                  // "3:42" o "127" — texto libre, parseable según metric
  unit        String?                                 // opcional, ej "kg"
  notes       String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([challengeId, patientId])
  @@index([challengeId])
}

// ============================================================================
// REUNIONES DEL EQUIPO (Reuniones)
// ============================================================================
// 4 pestañas en /fisio/reuniones. 3 categorías van por este modelo
// (la 4ª pestaña 'Sesiones clínicas' sigue usando ClinicalSessionCase):
//   "head_success" — acceso: CEO + head_success (prep CEO+head_success).
//   "comercial"    — acceso: CEO + setter + closer (prep CEO+setter).
//   "other"        — acceso: attendeesIds + CEO + head_success + setter.
//                    Prep: CEO + head_success + setter.
//
// Cada reunión tiene dos campos de texto largos: preparation (notas previas,
// solo managers) y summary (resumen, visible a todos los con acceso).
// ============================================================================
model TeamMeeting {
  id           String   @id @default(cuid())
  category     String                                  // "head_success" | "comercial" | "other"
  title        String
  scheduledAt  DateTime?
  preparation  String?                                 // texto largo, solo managers
  summary      String?                                 // texto largo, visible al equipo de esa categoría
  status       String   @default("upcoming")           // "upcoming" | "done" | "cancelled"
  createdById  String?
  attendeeIds  String   @default("[]")                 // JSON array de Professional.id (solo "other")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, scheduledAt])
}

// ============================================================================
// STORY MAKER — plantillas de composición para Instagram Stories
// ============================================================================
// jsonSlides = array de {bgColor, bgImageUrl?, elements: [...]}. Coord en %.

model ContentStoryTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  jsonSlides  String   @db.Text                        // JSON array de slides
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById, updatedAt])
}

model FisioAiBrief {
  id          String   @id @default(cuid())
  content     String
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ============================================================================
// PATIENT BANNERS
// Avisos que el CEO publica desde /fisio/ajustes/banners. Aparecen en el
// home de los pacientes filtrados por programa (RECUPERA/CONSOLIDA/ADVANCE/
// PREVENTION) durante la ventana startsAt-endsAt. Si dismissible=true, el
// paciente puede cerrarlo con OK y no le vuelve a salir (se registra en
// PatientBannerDismiss para que el CEO pueda ver quién lo cerró y quién no).
// ============================================================================
model PatientBanner {
  id                       String   @id @default(cuid())
  title                    String
  body                     String
  // "info" | "warning" | "success" — colorea el bloque en el home paciente
  variant                  String   @default("info")
  // JSON array con los programas destinatarios. Valores válidos:
  // "RECUPERA" | "CONSOLIDA" | "ADVANCE" | "PREVENTION". Array vacío = todos.
  targetProgramTypes       String
  startsAt                 DateTime
  endsAt                   DateTime
  // Si false, el paciente NO puede cerrarlo (aviso crítico).
  dismissible              Boolean  @default(true)
  createdByProfessionalId  String?
  createdBy                Professional? @relation("BannerCreatedBy", fields: [createdByProfessionalId], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  dismissals               PatientBannerDismiss[]

  @@index([startsAt, endsAt])
}

model PatientBannerDismiss {
  id          String   @id @default(cuid())
  bannerId    String
  banner      PatientBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dismissedAt DateTime @default(now())

  @@unique([bannerId, patientId])
  @@index([patientId])
}

model FisioAiAgent {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String
  icon               String
  brief              String
  order              Int      @default(0)
  usesPatientContext Boolean  @default(false)
  // Lista de roles con acceso a este agente. JSON stringified array de
  // "ceo" | "head_success" | "fisio" | "setter" | "closer". Si es null o
  // string vacío, el agente es visible para TODOS los miembros del equipo
  // (comportamiento por defecto tras habilitar Fisio IA en todo el equipo).
  allowedRoles       String?
  updatedById        String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@index([order])
}

// Bandeja de alertas del fisio: la IA (o el detector de metricas) va
// creando eventos cuando detecta algo que el fisio deberia mirar (mala
// sensacion en la nota post-sesion, desviacion de fatiga/sueño, etc).
// El fisio las gestiona desde /fisio/alertas. Nunca borramos, marcamos
// seenAt y dismissedAt para preservar historial + auditoria.
model PatientAlert {
  id             String   @id @default(cuid())
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String

  // "notes_ai"        → clasificacion IA sobre patientNotes
  // "metric_deviation" → daily-log fuera de umbral configurado
  kind           String
  // "info" | "warn" | "high" — solo warn+ se muestran por defecto en el buzon.
  severity       String
  // Texto conciso para pintar en la lista (≤120 chars). Escrito por la IA
  // en caso de notes_ai, o generado por el detector para metric_deviation.
  summary        String
  // JSON crudo del trigger (nota original, valores comparados…). Para
  // debug / ver detalle al abrir la alerta.
  triggerData    String?

  // De donde salio el evento. sourceId apunta a ProgramSession.id o
  // PatientDailyLog.id segun el kind.
  sourceType     String
  sourceId       String

  // Gestion.
  seenAt         DateTime?
  seenById       String?
  seenBy         Professional? @relation("AlertSeenBy", fields: [seenById], references: [id])
  dismissedAt    DateTime?
  dismissedById  String?
  dismissedBy    Professional? @relation("AlertDismissedBy", fields: [dismissedById], references: [id])

  createdAt      DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([seenAt])
  @@index([kind, severity])
}

// Plantilla global de config de alertas por metrica. Fila unica (id = "global").
// Los pacientes con metricAlertConfig=null usan esta plantilla al leer; los
// que tienen override usan su propio JSON. Editable por CEO/head_success.
model MetricAlertTemplate {
  id          String   @id
  config      String   // JSON stringificado con el mismo shape que Patient.metricAlertConfig
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Resumen semanal generado por IA (Sonnet) cada domingo noche para
// pacientes RECUPERA/CONSOLIDA con ≥2 sesiones esa semana. El fisio los
// consume en el feed lunes de /fisio y en la tab wods del paciente.
// Se guarda uno por (patientId, weekStartDate). dismissedAt marca que
// el fisio lo colapso del feed lunes; sigue accesible desde la ficha.
model PatientWeeklyReport {
  id             String   @id @default(cuid())
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  // Lunes UTC 00:00 de la semana resumida.
  weekStartDate  DateTime
  // Texto principal del resumen (200-500 chars) que sale de Sonnet.
  summary        String
  // JSON con datos estructurados (metricas medias, adherencia, deltas vs
  // semana anterior, sensaciones destacadas). Nulo si no hay bastantes datos.
  highlights     String?
  generatedAt    DateTime @default(now())
  // Marcado por el fisio para colapsar del feed lunes. La ficha sigue mostrandolo.
  dismissedAt    DateTime?
  dismissedById  String?

  @@unique([patientId, weekStartDate])
  @@index([weekStartDate])
  @@index([patientId, weekStartDate])
}

// Registro de "sesion completada" de pacientes ADVANCE (que no tienen
// ProgramSession porque usan rolling). Cada dia que el atleta pulsa "he
// terminado" en /sesion-hoy se crea/actualiza una fila con sus
// sensaciones. Sirve para: (a) que el resumen semanal del ADVANCE
// tenga notas subjetivas y (b) que el clasificador IA de sensaciones
// pueda leer estas notas igual que hace con ProgramSession.patientNotes.
model AdvanceSessionLog {
  id             String   @id @default(cuid())
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId      String
  // Dia natural en el que el atleta MARCO la sesion. Se guarda como
  // trazabilidad "cuando la marco realmente" pero ya no es la clave de
  // identidad (podria hacer la Sesion 1 del lunes en jueves).
  sessionDate    DateTime
  // Lunes UTC 00:00 de la semana a la que corresponde la sesion en el
  // rolling del atleta.
  weekStart      DateTime?
  // Indice de sesion (1..N) dentro de esa semana, ordenado por dayOfWeek
  // asc en el rolling. Es la clave real: al reordenar el rolling, el
  // atleta ve las sesiones etiquetadas como "Sesion 1", "Sesion 2", etc.
  sessionIndex   Int?
  patientNotes   String?
  // Snapshot de las tareas de esa sesion (JSON string) capturado en el
  // momento de marcarla. El historico refleja lo que hizo aunque el
  // rolling maestro cambie.
  tasksSnapshot  String?
  completedAt    DateTime @default(now())

  // Clave de identidad: una fila por (paciente, semana, indice). Los logs
  // legacy (pre-migracion) tienen weekStart/sessionIndex null y viven bajo
  // el indice antiguo por sessionDate.
  @@unique([patientId, weekStart, sessionIndex])
  @@index([sessionDate])
  @@index([patientId, weekStart])
}

// Card ejecutivo semanal para los pacientes ADVANCE (todos juntos). Los
// ADVANCE los lleva casi todo el CEO — no queremos spamear a los fisios
// con 40 reports individuales. En su lugar se genera este resumen global
// cada domingo noche y aparece como un card unico en /fisio/resumenes
// para CEO/head_success. Los reports individuales siguen guardandose en
// PatientWeeklyReport (para consulta en la ficha) pero no se listan en
// el feed.
model AdvanceWeeklySummary {
  id             String   @id @default(cuid())
  weekStartDate  DateTime @unique
  summary        String
  highlights     String?
  patientsCount  Int      @default(0)
  generatedAt    DateTime @default(now())
  dismissedAt    DateTime?
  dismissedById  String?

  @@index([weekStartDate])
}

// Tarifa de renovacion por programa y duracion. Editable solo por CEO
// desde /fisio/recursos/tarifas.
model RenewalRate {
  id           String   @id @default(cuid())
  programType  String
  periodMonths Int
  amount       Float
  currency     String   @default("EUR")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedById  String?

  @@unique([programType, periodMonths])
  @@index([programType])
}

// Documentos internos del equipo (protocolos, papers, plantillas legales,
// checklists...). Todos los profesionales pueden subir.
model ResourceDocument {
  id           String   @id @default(cuid())
  title        String
  description  String?
  url          String
  fileType     String   @default("pdf")
  fileSize     Int?
  category     String   @default("General")
  targetRoles  String   @default("all")
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// SKALEX / ZAPP · Setter IA de Instagram y WhatsApp
// ═══════════════════════════════════════════════════════════════════════════
// Espejo local de las conversaciones que Skalex nos expone en su API de datos
// (https://zapp.skalex.pro/api/v1). Sincronizado vía cron: por cada
// Lead/Patient con instagram o phone hacemos reverse-lookup.
//
// Fuente de verdad = Skalex. Aquí solo copiamos para queries rápidas y para
// cruzar con nuestro CRM en métricas.
model SkalexConversation {
  id             String   @id @default(cuid())
  // ID de conversación en Skalex (identificador natural para upsert)
  conversationId String   @unique

  platform       String   // "whatsapp" | "instagram" | ...
  customerName   String?
  customerPhone  String?
  igUsername     String?
  igUserId       String?  // IGSID: el mejor identificador para cruzar

  // Análisis IA (nullable si Skalex aún no ha analizado)
  aiPhase        Int?
  aiPhaseName    String?
  aiAnalysis     String?
  aiNextStepGoal String?
  aiUpdatedAt    DateTime?

  externalCreatedAt   DateTime
  lastMessageAt       DateTime

  // Enlaces resueltos con nuestro CRM (sin FK dura: si el Lead se borra,
  // el registro histórico de Skalex sigue vivo).
  leadId         String?
  patientId      String?

  labels         SkalexLabel[]

  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([igUserId])
  @@index([customerPhone])
  @@index([leadId])
  @@index([patientId])
  @@index([lastMessageAt])
  @@index([aiPhase])
}

model SkalexLabel {
  id               String   @id @default(cuid())
  conversationId   String
  conversation     SkalexConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  name             String   // "Interesado", "No interesado", "Agendó llamada"...
  color            String?
  addedAt          DateTime // cuándo Skalex marcó la etiqueta (base de métricas)

  createdAt        DateTime @default(now())

  @@unique([conversationId, name])
  @@index([name, addedAt])
  @@index([addedAt])
}

// Estado del sync (fila única id="singleton"): última vez que corrió el
// cron, cuántos leads procesó, si hubo error.
model SkalexSyncState {
  id              String   @id @default("singleton")
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  cursor          String?  // por si Skalex añade paginación por fecha
  lastProcessed   Int      @default(0)
  lastCreated     Int      @default(0)
  lastUpdated     Int      @default(0)

  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// CALL SUMMARY · Resumen IA de la videollamada de venta con Google Meet
// ═══════════════════════════════════════════════════════════════════════════
// Cuando termina la videollamada (Lead.meetingUrl → Google Meet), un cron
// consulta la Meet REST API para bajarse la transcripción, la pasa por
// Claude Sonnet y guarda aquí el resumen ejecutivo. Se muestra en la card
// de /fisio/llamadas-venta y en la ficha del paciente si el lead se
// convierte.
//
// leadId es @unique (una llamada = un resumen). Si la transcripción no
// existe (no se activó, aún se está generando, o Meet no la expone) el
// registro guarda noTranscript=true y no reintentamos infinito.
model CallSummary {
  id             String   @id @default(cuid())
  leadId         String   @unique
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Transcripción cruda (para poder regenerar el resumen sin volver a
  // llamar a Meet API si mejoramos el prompt en el futuro).
  transcriptText String?

  // Resumen ejecutivo generado por Sonnet 4.6. Dos versiones sobre la
  // misma transcripción: una comercial (para el equipo de venta) y una
  // clínica (para el fisio, se muestra sobre las notas de anamnesis).
  salesSummary       String?
  salesKeyPoints     String?  // JSON { motivations, objections, nextSteps }
  clinicalSummary    String?
  clinicalKeyPoints  String?  // JSON { mainComplaint, symptoms, history, contextLifestyle, goals, redFlags }
  // Coaching del closer: qué hizo bien, qué hizo mal, propuestas de mejora.
  // Solo se rellena para outcomes concluyentes (won/lost); en el resto queda null.
  coachingSummary    String?
  coachingKeyPoints  String?  // JSON { strengths, weaknesses, improvements }

  // Legacy: v1 devolvía un único resumen mixto (comercial + clínico).
  // Se conservan por si algún registro antiguo aún los usa; el generador
  // v2 los ignora y rellena sales* y clinical*.
  summary        String?
  keyPoints      String?
  // "won" | "lost" | "rescheduled" | "unclear" según la IA
  outcome        String?

  // Indica que Meet no expone transcript (no se activó, sesión demasiado
  // corta, permisos, etc). Cuando true no reintentamos.
  noTranscript   Boolean  @default(false)
  errorMessage   String?

  // Métricas para depurar
  transcriptCharCount Int?
  generationMs        Int?

  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([generatedAt])
}

