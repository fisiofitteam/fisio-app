  methodology     String   @default("")
  hardRules       String   @default("")
  goodExamples    String   @default("")
  briefPdfUrl     String?
  briefPdfName    String?
  briefPdfSize    Int?
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

model LoadReviewRecord {
