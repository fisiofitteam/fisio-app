generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id              String   @id @default(cuid())
  fullName        String
  email           String?  @unique
  phone           String?
  instagram       String?
  photoUrl        String?                           // foto de perfil del paciente
  sport           String   @default("CrossFit")
  diagnosis       String?
  bodyZone        String?                             // zona corporal clínica (hombro, lumbar...)
  startedAt       DateTime @default(now())

  subscriptionStartDate    DateTime?
  subscriptionPeriodMonths Int       @default(4)
  subscriptionTotalMonths  Int       @default(4)

  whatsappGroupUrl         String?

  dailyReminderEnabled     Boolean  @default(true)

  // Parche de bienvenida (regalo del setter al iniciar el programa)
  patchSent                Boolean   @default(false)
  patchSentAt              DateTime?
  // Camiseta ADVANCE
  shirtSize                String?
  // Se marca true al migrar pacientes existentes que ya recibieron sus
  // regalos. Oculta el selector de talla y los excluye de las listas de
  // envíos pendientes (camisetas + parches).
  giftsAlreadySent         Boolean    @default(false)
  shirtSent                Boolean   @default(false)
  shirtSentAt              DateTime?
  shippingAddress          String?    // legacy / texto libre (se mantiene por compat)
  shippingStreet           String?    // calle (ej. "Calle Mayor")
  shippingNumber           String?    // número (ej. "23")
  shippingFloor            String?    // piso (ej. "3º")
  shippingStaircase        String?    // escalera / patio
  shippingDoor             String?    // puerta (ej. "A")
  shippingCity             String?    // población
  shippingProvince         String?    // provincia
  shippingPostalCode       String?    // código postal
  shippingPhone            String?
  // País del paciente (se copia desde Lead.country al convertir).
  country                  String?
  // Zona horaria IANA del paciente (ej. "America/Bogota", "Europe/Madrid").
  timezone                 String?

  // Tipo de programa contratado y dificultad percibida (etiquetas visibles)
  programType String?                                   // "RECUPERA" | "CONSOLIDA" | "ADVANCE"
  difficulty  String?                                   // "FACIL" | "MEDIO" | "DIFICIL"

  // Modo de programa:
  //   "fixed"   = programa individual de N semanas (RECUPERA, CONSOLIDA, etc) - el original
  //   "rolling" = programa "a tiempo corrido" compartido (ADVANCE) - ve la semana actual del calendario
  programMode      String   @default("fixed")

  // Slot LEGACY (mantenido por compat con datos antiguos). En v49+ se usa
  // como "Rolling de entrenamiento" si rollingTrainingId es null.
  rollingProgramId String?
  rollingProgram   RollingProgram? @relation("PatientLegacyRolling", fields: [rollingProgramId], references: [id])

  // ADVANCE multi-Rolling: dos slots fijos con nombre semántico estable.
  // Accesorios: contenido de calentamiento/movilidad compartido con PREVENTION.
  // Entrenamiento: contenido específico de ADVANCE.
  rollingAccessoriesId String?
  rollingAccessories   RollingProgram? @relation("PatientAccessoriesRolling", fields: [rollingAccessoriesId], references: [id])
  rollingTrainingId    String?
  rollingTraining      RollingProgram? @relation("PatientTrainingRolling", fields: [rollingTrainingId], references: [id])

  // Perfil clínico aplicado (opcional)
  appliedLevelId  String?
  appliedLevel    ClinicalLevel? @relation(fields: [appliedLevelId], references: [id])

  // Fisio asignado (null = sin asignar todavía)
  assignedProfessionalId String?
  assignedProfessional   Professional? @relation("PatientAssignedTo", fields: [assignedProfessionalId], references: [id])

  // Revisión de cargas (cada X semanas).
  loadReviewIntervalWeeks Int      @default(4)
  loadReviewLastAt        DateTime?

  // Notas internas del fisio sobre el paciente.
  fisioNotes              String?

  // Notas de la "Llamada Anamnesis".
  anamnesisCallNotes      String?

  // Magic link de acceso 1-clic (sin código). Caducidad larga (365 días).
  accessToken             String?   @unique
  accessTokenExpiresAt    DateTime?

  // ─── ONBOARDING v57 ─────────────────────────────────────────────────────
  // Estado del flujo de onboarding tras pagar:
  //   "pending_assignment" → ha pagado, Miguel aún no le ha asignado fisio
  //   "active"             → fisio asignado, programa en marcha
  //   "paused"             → pausa (vacaciones, lesión secundaria...)
  //   "finished"           → programa terminado
  onboardingStatus       String   @default("active")

  // Fecha en la que el fisio marcó "Semana 0 completada" desde la lista.
  week0CompletedAt       DateTime?

  // Quién y cuándo asignó al fisio (típicamente Miguel = head_success)
  assignedByUserId       String?
  assignedByUser         Professional? @relation("PatientAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt             DateTime?
  assignmentNotes        String?

  // Duración contratada del programa (campos derivados de la compra)
  programDurationMonths  Int?
  programStartDate       DateTime?
  programEndDate         DateTime?

  // Datos para el contrato (firma electrónica)
  contractDNI            String?
  contractSignedAt       DateTime?
  contractSignedFromIP   String?
  contractSignedUserAgent String?
  contractVersion        String?     // "v1", "v2"... para versionar el contrato
  contractTextSnapshot   String?     // texto exacto firmado (legal evidence)

  // Anamnesis (cuestionario inicial del onboarding) — respuestas en JSON
  anamnesisData          String?     // JSON: { [clavePregunta]: valor }
  anamnesisCompletedAt   DateTime?

  // Última vez que abrió la comunidad (para badge "X notificaciones")
  communityLastSeenAt    DateTime?

  // Checklist de tareas iniciales (JSON)
  // Estructura: { "anamnesis": false, "contract": false, "firstSession": false }
  onboardingTasks        Json?

  // Hash de la contraseña (opcional - los pacientes antiguos siguen con login por código).
  // Los pacientes creados desde el flujo de pago v57+ tienen contraseña.
  passwordHash           String?

  adaptations     PatientAdaptation[]
  wodLogs         WodLog[]
  programAssignments ProgramAssignment[]
  metrics         PatientMetric[]
  fisioTasks      FisioTask[]
  scheduledCalls  ScheduledCall[]
  renewals        SubscriptionRenewal[]
  renewalCheckouts RenewalCheckout[]
  subscriptions   PatientSubscription[]
  clinicalSessionCase ClinicalSessionCase?
  transactions    Transaction[]
  prs             PatientPR[]
  challengeResults MonthlyChallengeResult[]
  dailyLogs       PatientDailyLog[]
  leadsConverted  Lead[]
  sessions        Session[]
  programPauses   ProgramPause[]
  notifications   PatientNotification[]
  pushTokens      PatientPushToken[]
  loadReviewRecords LoadReviewRecord[]
  categoryLevels  PatientCategoryLevel[]  @relation("PatientCategoryLevels")
  rollingOverrides PatientRollingTaskOverride[] @relation("PatientRollingOverrides")
  sales           Sale[]
  invoices        PatientInvoice[]
  communityComments  CommunityComment[]
  communityReactions CommunityReaction[]
  communityFeedPosts CommunityFeedPost[] @relation("FeedPostPatientAuthor")
  communityLessonProgress CommunityLessonProgress[]
}

// ============================================================================
// EQUIPO INTERNO (profesionales con rol)
// ============================================================================

model Professional {
  id        String   @id @default(cuid())
  fullName  String
  email     String?  @unique
  role      String                                     // "ceo" | "head_success" | "fisio" | "setter" | "closer"
  createdAt DateTime @default(now())

  // Auth: hash de contraseña bcrypt; null si aún no la ha establecido (recién invitado)
  passwordHash         String?
  // Token de invitación / reseteo de contraseña (one-time)
  passwordResetToken   String?  @unique
  passwordResetExpires DateTime?
  passwordSetAt        DateTime?
  lastLoginAt          DateTime?
  // Si está marcado como inactivo, no puede iniciar sesión (pero conservamos su historial)
  active               Boolean  @default(true)

  // Perfil / datos fiscales (autogestionados desde Ajustes → Perfil; usados en las facturas)
  fiscalName     String?   // nombre o razón social fiscal
  taxId          String?   // NIF / DNI / CIF
  fiscalAddress  String?   // dirección fiscal
  iban           String?
  photoUrl       String?
  workSchedule   String?   // horario de trabajo (texto libre, visible al equipo)
  vatExempt      Boolean   @default(true)  // exento de IVA (art. 20 Ley 37/1992)

  // Presentación corta que el closer usa al iniciar mensajes a leads/pacientes.
  // Se sustituye en plantillas con la variable {closer.intro}. Editable por CEO/head-success en /fisio/equipo.
  closerIntro    String?

  // Preferencias de notificación: JSON { [tipo]: boolean }. Tipo ausente = activado.
  notificationPrefs Json?

  // Última vez que abrió la pestaña Comunidad (para el badge de novedades en el sidebar).
  communityLastSeenAt DateTime?

  patients          Patient[]            @relation("PatientAssignedTo")
  patientsAssignedBy Patient[]           @relation("PatientAssignedBy")
  assignedTasks     FisioTask[]  @relation("AssignedToFisio")
  authoredTasks     FisioTask[]  @relation("AssignedByFisio")
  transactions      Transaction[]
  leadsAsSetter     Lead[]       @relation("LeadsAsSetter")
  leadsAsCloser     Lead[]       @relation("LeadsAsCloser")
  sessions          Session[]
  leaves            ProfessionalLeave[]
  closingShifts     ClosingShift[]       @relation("ClosingShifts")
  defaultShifts     DefaultClosingShift[]
  salesAsCloser     Sale[]               @relation("SaleByCloser")
  compensation      Compensation?
  communityFeedPosts     CommunityFeedPost[] @relation("FeedPostAuthor")
  communityFeedComments  CommunityComment[]  @relation("FeedCommentAuthor")
  communityFeedReactions CommunityReaction[] @relation("FeedReactionAuthor")
  weeklyTeamTaskCompletions WeeklyTeamTaskCompletion[] @relation("WeeklyTeamTaskCompletions")
  teamTaskAdHocCompletions  TeamTaskAdHocCompletion[]  @relation("TeamTaskAdHocCompletions")
  chatMemberships           ChatMember[]
  chatMessages              ChatMessage[]              @relation("ChatMessageAuthor")
  loadReviewRecords         LoadReviewRecord[]
}

// Condiciones laborales / compensación de un profesional (1:1). Solo CEO edita.
model Compensation {
  id                   String   @id @default(cuid())
  professionalId       String   @unique
  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  baseSalary           Float    @default(0)   // sueldo fijo €/mes
  perActivePatient     Float    @default(0)   // € por paciente activo
  renewalOwnPct        Float    @default(0)   // % sobre renovaciones de SUS pacientes
  renewalOthersPct     Float    @default(0)   // % sobre renovaciones del resto del equipo
  newSaleCommissionPct Float    @default(0)   // % sobre importe de ventas nuevas
  newSaleScope         String   @default("own") // "own" (cerradas por él) | "all"
  notes                String?
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// Nómina pagada de un profesional en un mes concreto. Al marcarla pagada se crea
// también una Transaction de tipo gasto (sueldos). Único por (profesional, año, mes).
model PayrollPayment {
  id             String   @id @default(cuid())
  professionalId String
  year           Int
  month          Int                              // 0-11
  amount         Float
  transactionId  String?                          // gasto asociado (para poder deshacer)
  paidById       String?
  paidAt         DateTime @default(now())

  @@unique([professionalId, year, month])
  @@index([year, month])
}

// ============================================================================
// FINANZAS (transacciones manuales + renovaciones cuentan automáticamente)
// ============================================================================

model Transaction {
  id          String   @id @default(cuid())
  // type: "income_new" (nueva alta) | "income_renewal" (renovación)
  //       | "income_other" (afiliados/formaciones/etc) | "expense"
  type        String
  // Solo para expense: "software" | "sueldos" | "marketing" | "otros"
  // Para ingresos puede ser null o el nombre del producto
  category    String?
  amount      Float                                      // € (positivo siempre; el signo viene del type)
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  patientId      String?
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type])
}

// ============================================================================
// LEADS / PIPELINE COMERCIAL
// ============================================================================

model Lead {
  id              String    @id @default(cuid())
  fullName        String
  contactType     String                                     // "phone" | "instagram" | "email"
  contactValue    String                                     // ej. "+34 600 123 456" o "@usuario"
  aiSummary       String?                                    // resumen breve de la conversación de la IA setter
  callScheduledAt DateTime                                   // fecha/hora de la llamada
  // status: "scheduled" (agendada) | "won" (venta) | "lost" (perdida)
  //       | "cancelled" (cancela antes) | "no_show" (no acude)
  status          String    @default("scheduled")
  inFollowUp      Boolean   @default(false)                  // vista aparte de follow-up
  followUpNote    String?
  followUpDate    DateTime?                                   // se mantiene por compat (puede usarse como fecha custom)

  // Sistema de follow-up automático: 4 fechas predefinidas con checkbox cada una
  followUpStartedAt DateTime?                                 // momento en que el closer marcó "follow-up"
  followUp24hDate    DateTime?
  followUp24hDone    Boolean @default(false)
  followUp48hDate    DateTime?
  followUp48hDone    Boolean @default(false)
  followUp30dDate    DateTime?
  followUp30dDone    Boolean @default(false)
  followUp90dDate    DateTime?
  followUp90dDone    Boolean @default(false)

  // Setter que registró el lead (solo informativo, hay uno solo por ahora)
  setterId        String?
  setter          Professional? @relation("LeadsAsSetter", fields: [setterId], references: [id], onDelete: SetNull)

  // Closer asignado
  closerId        String?
  closer          Professional? @relation("LeadsAsCloser", fields: [closerId], references: [id], onDelete: SetNull)

  // Si se gana, se convierte en Patient
  convertedPatientId String?
  convertedPatient   Patient? @relation(fields: [convertedPatientId], references: [id], onDelete: SetNull)

  // Si se pierde, razón
  lostReason      String?                                    // "precio" | "no_encaja" | "ghosting" | "otro"

  // ─── Auto-agenda desde landing pública (v54) ───
  // Si el lead vino de la landing pública, se rellenan estos campos.
  // Si lo creó la setter manualmente, quedan null.
  email           String?                                    // correo del formulario público
  phone           String?                                    // teléfono del formulario público
  instagram       String?                                    // @usuario de Instagram (formulario público)
  aiScheduled     Boolean   @default(false)                  // marcar si fue agendado por la IA (para métricas)
  country         String?                                    // país (opcional, no obligatorio)
  motivo          String?                                    // "¿Qué te trae aquí?"
  tratamientosPrevios String?                                // qué ha probado antes
  impactoCrossfit String?                                    // cómo afecta a su entrenamiento
  meetingUrl      String?                                    // URL de Google Meet
  googleEventId   String?                                    // id del evento en Calendar (para sincronizar)
  source          String?                                    // "landing" | "manual" | (futuros: "ads_meta", "ads_google", ...)
  bookedAt        DateTime?                                  // momento exacto en que se hizo la reserva pública

  // ─── Re-agenda autoservicio ───
  rescheduleToken     String?   @unique
  rescheduleTokenAt   DateTime?
  rescheduledAt       DateTime?

  // ─── Etapas comerciales (workflow setter → closer) ───
  // Cuándo el setter marcó "avisado" (paso 1 hecho)
  setterNotifiedAt    DateTime?
  // Cuándo el closer marcó "contactado" (caso de éxito enviado, paso 2 hecho)
  closerContactedAt   DateTime?
  // Cuándo el closer marcó "recordatorio enviado" (paso 3 hecho, día antes de la cita)
  reminderSentAt      DateTime?

  adUtmCampaign   String?
  adUtmSource     String?
  adUtmMedium     String?
  adUtmContent    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  decidedAt       DateTime?                                   // cuándo se marcó won/lost/postponed

  sales           Sale[]
  fisioTasks      FisioTask[] @relation("LeadFisioTasks")

  sourceTagId     String?
  sourceTag       LeadSourceTag? @relation(fields: [sourceTagId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([callScheduledAt])
  @@index([closerId])
  @@index([inFollowUp])
  @@index([adUtmCampaign])
  @@index([sourceTagId])
}

model LeadSourceTag {
  id        String   @id @default(cuid())
  label     String   @unique
  color     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]

  @@index([active])
}

model ClinicalProfile {
  id          String          @id @default(cuid())
  name        String                              // "Hombro: Impingement subacromial"
  bodyZone    String                              // "hombro", "lumbar", "rodilla"
  description String?
  createdAt   DateTime        @default(now())

  levels      ClinicalLevel[]
}

model ClinicalLevel {
  id          String          @id @default(cuid())
  profileId   String
  profile     ClinicalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name        String                              // "Nivel 1 - Fase aguda"
  order       Int                                 // 1, 2, 3, 4, 5
  description String?

  rules       ClinicalLevelRule[]
  patients    Patient[]

  @@unique([profileId, order])
}

model ClinicalLevelRule {
  id              String        @id @default(cuid())
  levelId         String
  level           ClinicalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  movementId      String
  movement        Movement      @relation(fields: [movementId], references: [id])

  state           String        // "OK", "CONDITIONAL", "BLOCKED"
  substitutionText String?
  loadConstraint  String?
  physioWarning   String?

  @@unique([levelId, movementId])
}

model MovementCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?

  // Orden visual (editable con ↑/↓ desde el catálogo)
  order       Int        @default(0)

  movements   Movement[]
  levels      CategoryLevel[]
  patientSelections PatientCategoryLevel[]
}

model CategoryLevel {
  id              String   @id @default(cuid())
  categoryId      String
  category        MovementCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  order           Int
  description     String?
  createdAt       DateTime @default(now())
  rules           CategoryLevelRule[]
  patientSelections PatientCategoryLevel[]
  @@unique([categoryId, order])
}

model CategoryLevelRule {
  id              String   @id @default(cuid())
  categoryLevelId String
  categoryLevel   CategoryLevel @relation(fields: [categoryLevelId], references: [id], onDelete: Cascade)
  movementId      String
  movement        Movement @relation("MovementRules", fields: [movementId], references: [id], onDelete: Cascade)
  state            String
  loadConstraint   String?
  substitutionText String?
  physioWarning    String?
  @@unique([categoryLevelId, movementId])
}

model PatientCategoryLevel {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation("PatientCategoryLevels", fields: [patientId], references: [id], onDelete: Cascade)
  categoryId      String
  category        MovementCategory @relation(fields: [categoryId], references: [id])
  categoryLevelId String
  categoryLevel   CategoryLevel @relation(fields: [categoryLevelId], references: [id])
  updatedAt       DateTime @updatedAt
  @@unique([patientId, categoryId])
  @@index([patientId])
}

model Movement {
  id            String           @id @default(cuid())
  categoryId    String
  category      MovementCategory @relation(fields: [categoryId], references: [id])

  canonicalName String           @unique
  displayName   String
  aliases       String           // CSV: "thr,thrusters,th"

  isOverhead    Boolean          @default(false)
  isImpact      Boolean          @default(false)
  isKipping     Boolean          @default(false)

  adaptations   PatientAdaptation[]
  clinicalRules ClinicalLevelRule[]
  categoryRules CategoryLevelRule[] @relation("MovementRules")
}

model PatientAdaptation {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  movementId       String
  movement         Movement @relation(fields: [movementId], references: [id])

  state            String   // "OK", "CONDITIONAL", "BLOCKED"
  substitutionText String?
  loadConstraint   String?
  physioWarning    String?

  // true si el fisio ha editado esta adaptación a mano desde el editor. Cuando
  // es true, materializePatientCategoryLevels() NO la pisa aunque cambie el
  // nivel del paciente. Volver a "por defecto del nivel" requiere el botón
  // explícito "Restablecer al nivel".
  isCustomized     Boolean  @default(false)

  updatedAt        DateTime @updatedAt

  @@unique([patientId, movementId])
}

model WodLog {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  rawText         String
  adaptedText     String
  rpe             Int?
  painScore       Int?
  notes           String?
  completedAt     DateTime?
  submittedAt     DateTime @default(now())
}

// ============================================================================
// BIBLIOTECA DE EJERCICIOS (con vídeos del fisio)
// ============================================================================

model ExerciseLibrary {
  id          String   @id @default(cuid())
  name        String                                // "Cat-camel", "Strict press"
  bodyZone    String   @default("otros")            // "hombro" | "lumbar" | "rodilla" | "otros"
  category    String                                // "Movilidad", "Activación", "Fuerza"...
  tags        String   @default("")                 // CSV: "hombro,escapular,activación"
  youtubeUrl  String?                                // URL completa o ID
  description String?                                // cues técnicos
  createdAt   DateTime @default(now())

  workoutLinks WorkoutExercise[]
  rollingLinks RollingTaskExercise[]
}

// ============================================================================
// PROGRAMAS (estructura: semanas × 7 días × N tareas)
// ============================================================================

model Program {
  id          String   @id @default(cuid())
  name        String
  bodyZone    String   @default("otros")                // "hombro" | "lumbar" | "rodilla" | "otros"
  type        String                                    // sub-etiqueta: "Movilidad", "Tendinoso", "Exposición"...
  level       Int      @default(1)
  description String?
  weeksCount  Int      @default(4)
  isStandalone Boolean @default(false)                  // true = sesión suelta, no aparece en biblioteca
  createdAt   DateTime @default(now())

  weeks       ProgramWeek[]
  assignments ProgramAssignment[]
}

model ProgramWeek {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  weekNumber  Int                                   // 1, 2, 3, 4...
  notes       String?

  days        ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id          String      @id @default(cuid())
  weekId      String
  week        ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayOfWeek   Int                                   // 1=lunes, 7=domingo

  tasks       ProgramTask[]

  @@unique([weekId, dayOfWeek])
}

// Una tarea genérica. type indica qué subtabla mirar.
model ProgramTask {
  id        String     @id @default(cuid())
  dayId     String
  day       ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  type      String                                  // "WORKOUT", "VIDEO", "FORM", "EVOLUTION"
  order     Int        @default(0)
  title     String                                  // título visible al paciente

  // Una tarea tiene una y solo una de estas:
  workout      TaskWorkout?
  video        TaskVideo?
  form         TaskForm?
  evolution    TaskEvolution?

  @@index([dayId, order])
}

model TaskWorkout {
  id        String      @id @default(cuid())
  taskId    String      @unique
  task      ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  bodyText  String                                  // bloque de texto libre con el WOD

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id          String          @id @default(cuid())
  workoutId   String
  workout     TaskWorkout     @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId  String
  exercise    ExerciseLibrary @relation(fields: [exerciseId], references: [id])

  order       Int             @default(0)

  @@unique([workoutId, exerciseId])
}

model TaskVideo {
  id          String      @id @default(cuid())
  taskId      String      @unique
  task        ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  youtubeUrl  String
  description String?
}

model TaskForm {
  id        String      @id @default(cuid())
  taskId    String      @unique
  task      ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  questions String                                  // JSON: [{id, text, type, options?}]
}

model TaskEvolution {
  id          String      @id @default(cuid())
  taskId      String      @unique
  task        ProgramTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  instructions String?                              // texto opcional al paciente
}

// ============================================================================
// MÉTRICAS DE EVOLUCIÓN POR PACIENTE
// ============================================================================

model PatientMetric {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  key         String                                 // "pain", "rpe", "stiffness", "strength" o custom
  name        String                                 // "Dolor", "RPE percibido"...
  unit        String?                                // "0-10", "kg", "cm"...
  isPreset    Boolean  @default(false)               // true para las 4 precargadas
  isVisible   Boolean  @default(true)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  entries     MetricEntry[]

  @@unique([patientId, key])
  @@index([patientId])
}

model MetricEntry {
  id         String        @id @default(cuid())
  metricId   String
  metric     PatientMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  value      Float
  recordedAt DateTime      @default(now())
  source     String        @default("manual")        // "manual" | "session" | "form"
  sessionId  String?                                  // si vino de completar una sesión

  @@index([metricId, recordedAt])
}

// Métricas GENERALES definidas por el CEO (Biblioteca → Métricas). Se aplican
// a todos los pacientes: al ver su evolución se materializan como PatientMetric
// (así aparecen asignadas aunque no haya datos). key estable.
model MetricDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  unit      String?
  auto      Boolean  @default(false)   // true: se rellena desde las sesiones (pain/rpe/stiffness)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

// ============================================================================
// ASIGNACIONES Y SESIONES
// ============================================================================

model ProgramAssignment {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  programId   String
  program     Program  @relation(fields: [programId], references: [id])

  startDate   DateTime                              // un lunes
  weeksCount  Int                                   // duración real
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  sessions    ProgramSession[]

  @@index([patientId])
}

model ProgramSession {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  scheduledDate DateTime
  weekNumber    Int
  dayOfWeek     Int                                 // 1-7

  // Snapshot de las tareas del día (JSON estructurado)
  tasksSnapshot String                              // JSON: [{id, type, title, ...payload}]

  // Estado completado por el paciente: JSON con respuestas por tarea
  completedAt   DateTime?
  responses     String?                              // JSON: {taskId: {...respuestas}}

  // Revisión por el fisio (solo aplica si la sesión tenía formularios completados)
  formReviewedAt DateTime?

  @@index([scheduledDate])
  @@index([assignmentId, scheduledDate])
}

// ============================================================================
// TAREAS DEL FISIO
// ============================================================================

model FisioTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Tarea puede estar asociada a un lead (típico para closer/setter) en vez de un paciente.
  leadId      String?
  lead        Lead?    @relation("LeadFisioTasks", fields: [leadId], references: [id], onDelete: SetNull)

  // Plantilla de mensaje asociada a la tarea. Si está, la card muestra "📤 Enviar"
  // que ejecuta la acción de la plantilla (selector de caso → WhatsApp interpolado).
  messageTemplateId String?
  messageTemplate   MessageTemplate? @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)

  source      String   @default("own")               // "own" | "team"
  // El campo assignedBy puede ser texto libre o un ID de Professional (lo decidimos en la UI)
  assignedBy  String?
  assignedByProfessionalId String?
  assignedByProfessional   Professional? @relation("AssignedByFisio", fields: [assignedByProfessionalId], references: [id])

  // assignedTo: CSV de IDs de Professional cuando es tarea de equipo
  assignedTo  String?
  // Para queries: relación con UN profesional principal (si solo hay uno)
  assignedToProfessionalId String?
  assignedToProfessional   Professional? @relation("AssignedToFisio", fields: [assignedToProfessionalId], references: [id])

  priority    String   @default("medium")             // "low" | "medium" | "high"

  // Recurrencia
  recurrenceType  String   @default("none")           // "none" | "daily" | "weekly" | "monthly"
  recurrenceDay   Int?                                // si weekly: 1-7; si monthly: 1-31
  parentTaskId    String?

  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([completedAt])
  @@index([dueDate])
  @@index([source])
}

