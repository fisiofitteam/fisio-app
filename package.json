{
  "name": "fisio-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:prod": "node scripts/use-schema.js prod && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:push:prod": "bash scripts/db-push-prod.sh",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "schema:dev": "node scripts/use-schema.js dev",
    "schema:prod": "node scripts/use-schema.js prod",
    "reset:prelaunch": "bash scripts/reset-prelaunch.sh",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "cap:assets": "node scripts/generate-assets.mjs && npx @capacitor/assets generate --iconBackgroundColor \"#FBBF24\" --iconBackgroundColorDark \"#FBBF24\" --splashBackgroundColor \"#0A0A0A\" --splashBackgroundColorDark \"#0A0A0A\"",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.20.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.452.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "resend": "^4.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5"
  }
}
